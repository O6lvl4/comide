#!/bin/sh
# Launches comide and puts the terminal back however it ends.
#
# In a conversation comide takes the terminal over key by key (src/term.almd) and restores
# it when it leaves. A panic does not leave: it ends the process where it stands, and the
# terminal would stay without echo and without ^C. This wrapper saves the settings first
# and restores them after, whatever the exit.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
saved=""
if [ -t 0 ]; then saved=$(stty -g 2>/dev/null); fi
"$here/../comide" "$@"
code=$?
if [ -n "$saved" ]; then
  stty "$saved" 2>/dev/null
  [ -t 1 ] && printf '\033[?2004l\033[?25h'
fi
exit $code
