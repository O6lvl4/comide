// comide: a conversation that can look at code and change it.
//
// The loop is the one every coding agent has: send the conversation and the tools, run
// whatever tools the model calls, send their results back, and stop when it answers in
// words. What is particular here is what the tools are (see tools.almd): the reads are
// hew, the writes go through golemide's syntax gate, and a change a command can check
// is handed to golemide solve whole, so its repair loop runs outside the conversation
// and only its result comes back into it.
//
// The parts: convo.almd (the conversation as data), waiting.almd (one model call,
// watched), turn.almd (one request worked to an answer), asking.almd (a command put to
// the person first). This file is the conversation around them and the command line.
//
// What it looks like is ui.almd. Interactively everything goes to stdout, the answer
// streamed as it is written; with -p the answer alone goes to stdout and the tool calls
// to stderr, so a script can take the answer and a person can still watch.

import io
import env
import fs
import process
import self.model
import self.tools
import self.toolkit
import self.solving
import self.envfile
import self.ui
import self.term
import self.editor
import self.convo
import self.options
import self.turn

fn system_prompt(root: String) -> String = """
You are comide, a coding assistant working in the project at ${root}. You talk with the user and use tools to look at and change the code.

The division of labour: you decide what to change; golemide does the changing. When a command can tell whether the work is done (a test suite, a build, a checker), or you can find one (a test file, cargo test, pytest, go test, npm test), hand the change to solve with that command as verify. Do this before writing any of the implementation yourself: solve reads the code, edits it, runs the command and retries on the failures on its own, at a fraction of the cost of the same steps here. golemide reads the code and the tests itself, so do not read them for it: when the request already names the command, call solve first, with the request as the task; otherwise look only as much as you need to find the command and state the task.

Finding the command, when the request does not name one: the project says how its tests run, in its build and test configuration (the build file, the package's scripts, a Makefile, the CI workflow, the README or contributing notes). Read that rather than guessing. verify is a claim that the work is done, so the command must:
- exist as written: every program, script, target and path in it comes from what you read. Never invent a name, such as the test binary a build produces.
- run all the tests: look for tests the configuration leaves out (skipped, ignored, disabled, or compiled only behind an option) and include what turns them on, without editing the test files unless the user asked.
- fail when a test fails: nothing after it may replace its exit status.
When you are not sure it does all three, run it once with shell before solve: on the unfinished code it should run the tests and fail on the missing work, not on the command.

Edit yourself only when solve does not fit: no command can check the change, or it is a line or two you can already see in full. When solve reports the command passing, the work is done: do not run the command again, and do not tidy what golemide wrote (warnings, style) unless the user asked for it. If solve stops without passing, read its report, then call it again with a sharper task or finish the rest yourself.

How to work:
- Look before you change anything. In a project you have not seen, start with map or tree. Read narrowly, by symbol, lines or grep, rather than whole large files.
- When you need several things you can already name (files or symbols to read, outlines, searches), ask for them all in one reply. Every call in a reply runs before the next model call, and each model call is slow: one reply with five reads is much faster than five replies with one.
- Look with tree, map, outline, search and read, never with shell (no ls, cat, grep or find): they need no permission, and shell does.
- Change a file yourself with edit, copying old exactly from what read showed, without the line numbers. Use write for a new file or a complete rewrite.
- Run tests and other commands with shell. The user may decline.
- For what the project cannot tell you, such as library documentation, an unfamiliar error or a recent release, use web_search and then web_fetch the page that answers. Say which page an answer came from, and do not present a snippet you have not read as fact.
- Every write is syntax-checked first. If an edit is refused, read the reason, look again, and retry.

When you answer:
- Be brief. Say what you changed and how you know it works. If nothing checked it, say so.
- Answer in the language the user wrote in.
"""

// ---- slash commands --------------------------------------------------------------------

type Slash = { name: String, arg: String }

fn command_of(line: String) -> Slash? = {
  let t = string.trim(line)
  if not string.starts_with(t, "/") then none
  else match string.split_once(t, " ") {
    some((n, a)) => some(Slash { name: n, arg: string.trim(a) }),
    none => some(Slash { name: t, arg: "" }),
  }
}

let COMMANDS = [
  editor.Command { name: "/help", about: "keys and commands" },
  editor.Command { name: "/clear", about: "forget the conversation, keep the project and the cost" },
  editor.Command { name: "/cost", about: "what this session has spent" },
  editor.Command { name: "/model", about: "show or switch the model" },
  editor.Command { name: "/yes", about: "run shell and verify commands without asking, or ask again" },
  editor.Command { name: "/transcript", about: "where this session's messages are written" },
  editor.Command { name: "/exit", about: "leave" },
]

let KEYS_HELP = """
  enter send · alt+enter or \\ then enter a new line · ↑↓ history · tab complete a command
  esc or ctrl+c while comide works: interrupt · ctrl+c twice or ctrl+d on an empty box: leave
"""

type Place = { setup: toolkit.Setup, fresh: options.Session, transcript: String, shown_root: String, history_file: String }

// What the tools work with: the project, golemide, a scratch directory of this process's
// own, and the helpers found on this machine.
effect fn setup_of(opts: options.Options) -> Result[toolkit.Setup, String] = {
  let scratch = (string.strip_suffix(env.temp_dir(), "/") ?? env.temp_dir()) + "/comide-" + int.to_string(process.pid())
  fs.mkdir_p(scratch)!
  let has_ctxgate = match process.exec_status("bash", ["-c", "command -v ctxgate"]) { ok(st) => st.code == 0, err(_) => false }
  let searx = string.strip_suffix(env.get("COMIDE_SEARXNG_URL") ?? "http://127.0.0.1:8888", "/") ?? "http://127.0.0.1:8888"
  // The model solve runs on, golemide's defaults unless set; the strong one follows it,
  // so a run on one provider stays on it.
  let solve_model = string.trim(env.get("COMIDE_SOLVE_MODEL") ?? "")
  let solve_strong = string.trim(env.get("COMIDE_SOLVE_STRONG_MODEL") ?? "")
  ok(toolkit.Setup { root: opts.root, golemide: opts.golemide, scratch: scratch, ctxgate: has_ctxgate, searx: searx,
    solve_model: solve_model, solve_strong: if solve_strong != "" then solve_strong else solve_model })
}

effect fn chat(opts0: options.Options) -> Result[Int, String] = {
  let home = env.get("HOME") ?? ""
  let _ = envfile.load(envfile.dirs_for(opts0.root)!)!
  // Checked before anything else happens, so a missing key is said once, not as a
  // failed first request. The endpoint is looked up again on every call: /model can change it.
  let _ = model.endpoint_of(opts0.model)!
  let golemide_problem = solving.golemide_problem(opts0.golemide)!
  if golemide_problem != "" then options.show(opts0, ui.note_line(opts0.ui, golemide_problem))!
  let setup = setup_of(opts0)!
  let system = system_prompt(opts0.root) + "\n" + tools.project_context(setup)!
  let fresh = options.Session { messages: [convo.message("system", system)], cost: 0.0, allow_shell: opts0.yes, steps: 0, check: "" }
  let _ = fs.mkdir_p(home + "/.comide")
  let place = Place { setup: setup, fresh: fresh, transcript: setup.scratch + "/transcript.json",
    shown_root: match string.strip_prefix(opts0.root, home) { some(rest) => "~" + rest, none => opts0.root },
    history_file: home + "/.comide/history" }
  if not opts0.live then {
    let _ = turn.turn(opts0, setup, fresh, opts0.prompt)!
    eprintln(ui.note_line(opts0.ui, "transcript: " + place.transcript))
    ok(0)
  } else {
    // The terminal is taken over only when stdin is one; a pipe keeps the line reader.
    let saved = if term.is_tty()! then term.enter_raw()! else none
    let tui = option.is_some(saved)
    let (_, cols) = if tui then term.size()! else (24, opts0.ui.width)
    let outcome = match talk(options.with_terminal(opts0, tui, ui.Ui { color: opts0.ui.color, width: int.max(40, int.min(160, cols)) }), place) {
      ok(n) => ok(n),
      err(e) => err(e),
    }
    match saved { some(sv) => term.leave_raw(sv)!, none => () }
    outcome
  }
}

fn status_of(opts: options.Options, place: Place, s: options.Session) -> String =
  opts.model + " · " + ui.fit_path(place.shown_root, 40) + " · " + convo.usd(s.cost)
    + (if s.allow_shell then " · commands run without asking" else "") + " · /help"

// One line of the conversation from the person: the input box on a terminal, a plain
// line from a pipe. `none` is the end of the conversation.
effect fn next_line(opts: options.Options, place: Place, s: options.Session, history: List[String]) -> String? =
  if opts.tui then {
    var got: String? = none
    var asking = true
    while asking {
      let p = editor.prompt(opts.ui, history, "ask, or tell comide what to change  ·  / for commands", status_of(opts, place, s), COMMANDS)!
      if p.kind == "send" then { got = some(p.text); asking = false }
      else if p.kind == "leave" then asking = false
    }
    got
  } else {
    println("\n" + ui.prompt_rule(opts.ui))
    io.print(ui.prompt_head(opts.ui))
    options.read_input()!
  }

// Where a conversation stands between two lines from the person.
type Talk = { opts: options.Options, s: options.Session, open: Bool }

effect fn talk(opts0: options.Options, place: Place) -> Result[Int, String] = {
  let u = opts0.ui
  var t = Talk { opts: opts0, s: place.fresh, open: true }
  var history = if opts0.tui then editor.load_history(place.history_file)! else []
  println(ui.banner(u, opts0.model, place.shown_root))
  while t.open {
    // Measured before every prompt, so a window made wider or narrower mid-session gets
    // a box that fits it.
    if t.opts.tui then {
      println("")
      let (_, cols) = term.size()!
      t = { ...t, opts: options.with_terminal(t.opts, true, ui.Ui { color: t.opts.ui.color, width: int.max(40, int.min(160, cols)) }) }
    }
    match next_line(t.opts, place, t.s, history)! {
      none => { t = { ...t, open: false } },
      some(text) => {
        if t.opts.tui then { editor.remember(place.history_file, text)!; list.push(history, text) }
        t = match command_of(text) {
          some(c) => slash(t, place, c)!,
          none => if string.trim(text) == "" then t else { ...t, s: turn.turn(t.opts, place.setup, t.s, text)! },
        }
      },
    }
  }
  println(ui.note_line(u, "transcript: " + place.transcript + " · session " + convo.usd(t.s.cost)))
  ok(0)
}

// A slash command, done.
effect fn slash(t: Talk, place: Place, c: Slash) -> Talk = {
  let u = t.opts.ui
  let s = t.s
  if c.name == "/exit" or c.name == "/quit" then { ...t, open: false }
  else if c.name == "/help" then { println(ui.help(u) + (if t.opts.tui then "\n\n" + ui.dim(u, KEYS_HELP) else "")); t }
  else if c.name == "/clear" then {
    println(ui.note_line(u, "the conversation is cleared; the project and the cost so far are kept"))
    { ...t, s: options.Session { messages: place.fresh.messages, cost: s.cost, allow_shell: s.allow_shell, steps: s.steps, check: "" } }
  }
  else if c.name == "/cost" then { println(ui.note_line(u, "this session: " + convo.usd(s.cost) + " over " + int.to_string(s.steps) + " model calls")); t }
  else if c.name == "/model" then switch_model(t, c.arg)!
  else if c.name == "/yes" then {
    let allow = not s.allow_shell
    println(ui.note_line(u, if allow then "shell and verify commands now run without asking" else "shell and verify commands are asked about again"))
    { ...t, s: options.Session { messages: s.messages, cost: s.cost, allow_shell: allow, steps: s.steps, check: s.check } }
  }
  else if c.name == "/transcript" then { println(ui.note_line(u, place.transcript)); t }
  else { println(ui.note_line(u, "no command " + c.name + "; /help lists them")); t }
}

effect fn switch_model(t: Talk, to: String) -> Talk = {
  let u = t.opts.ui
  if to == "" then { println(ui.note_line(u, "model: " + t.opts.model + "   (/model cf:glm-5.3-flash, /model claude, /model openai:gpt-5 to switch)")); t }
  else match model.endpoint_of(to) {
    ok(_) => { println(ui.note_line(u, "model: " + to)); { ...t, opts: options.with_model(t.opts, to) } },
    err(e) => { println(ui.note_line(u, e + "; still " + t.opts.model)); t },
  }
}

fn opt(args: List[String], name: String) -> String? =
  match list.index_of(args, name) { none => none, some(i) => list.get(args, i + 1) }

fn absolute(root: String, cwd: String) -> String = {
  let r = string.strip_suffix(root, "/") ?? root
  if string.starts_with(root, "/") then (if r == "" then "/" else r)
  else if r == "" or r == "." then cwd
  else cwd + "/" + (string.strip_prefix(r, "./") ?? r)
}

let CHAT_USAGE = """
comide [run PROMPT | -p PROMPT] [--root DIR] [--model M] [--effort E] [--yes] [--max-steps N] [--golemide PATH]

  run PROMPT       one request, answered, then exit; without it, a conversation
  -p PROMPT        the same as run
  --root DIR       the project (default: the working directory)
  --model M        which model thinks, as PROVIDER:MODEL (default cf:glm-5.3)
                     cf:glm-5.3, cf:glm-5.3-flash, ...   Cloudflare Workers AI
                     openai:gpt-5, openrouter:..., ollama:qwen3, ...
                                     any OpenAI-compatible service: NAME_API_KEY, and
                                     NAME_BASE_URL for one comide does not know
                     claude, claude:opus  Claude Code's `claude -p`, on your Claude login
  --effort E       reasoning effort, sent to Cloudflare only: low (default), medium, high
  --yes            run shell and verify commands without asking
  --max-steps N    model calls per request before it stops to ask (default 40)
  --golemide PATH  the golemide binary (default: $COMIDE_GOLEMIDE, else golemide on PATH)

solve runs on golemide's own models (cf:glm-5.3-flash, escalating to cf:glm-5.3);
COMIDE_SOLVE_MODEL and COMIDE_SOLVE_STRONG_MODEL choose others, with the same names.

In a conversation: /help /clear /cost /model /yes /transcript /exit
"""

effect fn cli(args: List[String]) -> Int =
  if list.contains(args, "--help") or list.contains(args, "-h") then { println(CHAT_USAGE); 0 }
  else {
    let prompt = opt(args, "-p") ?? ""
    let opts = options.Options {
      root: absolute(opt(args, "--root") ?? ".", env.cwd() ?? "."),
      // The conversation runs on the full model: it is where the request is understood,
      // the tools are chosen and the answer is written, a few calls a turn. The repair
      // loop behind `solve` stays on golemide's own default, flash, which is where the
      // many cheap calls are and where golemide was measured.
      model: opt(args, "--model") ?? "cf:glm-5.3",
      effort: opt(args, "--effort") ?? "low",
      max_steps: int.parse(opt(args, "--max-steps") ?? "40") ?? 40,
      max_tokens: 16384,
      yes: list.contains(args, "--yes"),
      prompt: prompt,
      golemide: opt(args, "--golemide") ?? (env.get("COMIDE_GOLEMIDE") ?? "golemide"),
      live: prompt == "",
      tui: false,
      ui: ui.detect()!,
    }
    match chat(opts) { ok(code) => code, err(e) => { eprintln(e); 2 } }
  }

test "a line starting with a slash is a command" {
  assert_eq(command_of("/model cf:glm-5.3"), some(Slash { name: "/model", arg: "cf:glm-5.3" }))
  assert_eq(command_of("  /exit "), some(Slash { name: "/exit", arg: "" }))
  assert_eq(command_of("fix the tests"), none)
}

test "a relative root is taken from the working directory" {
  assert_eq(absolute(".", "/w/p"), "/w/p")
  assert_eq(absolute("sub/", "/w/p"), "/w/p/sub")
  assert_eq(absolute("/abs", "/w/p"), "/abs")
}
