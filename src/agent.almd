// comide: a conversation that can look at code and change it.
//
// The loop is the one every coding agent has: send the conversation and the tools, run
// whatever tools the model calls, send their results back, and stop when it answers in
// words. What is particular here is what the tools are (see tools.almd): the reads are
// hew, the writes go through golemide's syntax gate, and a change a command can check
// is handed to golemide solve whole, so its repair loop runs outside the conversation
// and only its result comes back into it.
//
// The parts: convo.almd (the conversation as data), waiting.almd (one model call,
// watched), turn.almd (one request worked to an answer), asking.almd (a command put to
// the person first). This file is the conversation around them and the command line.
//
// What it looks like is ui.almd. Interactively everything goes to stdout, the answer
// streamed as it is written; with -p the answer alone goes to stdout and the tool calls
// to stderr, so a script can take the answer and a person can still watch.

import io
import env
import fs
import process
import json
import self.model
import self.tools
import self.toolkit
import self.solving
import self.envfile
import self.ui
import self.term
import self.editor
import self.convo
import self.options
import self.turn
import self.penned
import self.confined
import self.web
import self.reference
import self.briefing
import self.skills
import self.handover
import self.sessions
import self.memory
import self.goal
import self.settings
import self.mcp
import self.rules
import self.checkpoints
import self.waiting
import self.exported

fn system_prompt(root: String) -> String = """
You are comide, a coding assistant working in the project at ${root}. You talk with the user and use tools to look at and change the code.

The division of labour: you decide what to change; golemide does the changing. When a command can tell whether the work is done (a test suite, a build, a checker), or you can find one (a test file, cargo test, pytest, go test, npm test), hand the change to solve with that command as verify. Do this before writing any of the implementation yourself: solve reads the code, edits it, runs the command and retries on the failures on its own, at a fraction of the cost of the same steps here. golemide reads the code and the tests itself, so do not read them for it: when the request already names the command, call solve first, with the request as the task; otherwise look only as much as you need to find the command and state the task.

Finding the command, when the request does not name one: the project says how its tests run, in its build and test configuration (the build file, the package's scripts, a Makefile, the CI workflow, the README or contributing notes). Read that rather than guessing. verify is a claim that the work is done, so the command must:
- exist as written: every program, script, target and path in it comes from what you read. Never invent a name, such as the test binary a build produces.
- run all the tests: look for tests the configuration leaves out (skipped, ignored, disabled, or compiled only behind an option) and include what turns them on, without editing the test files unless the user asked.
- fail when a test fails: nothing after it may replace its exit status.
When you are not sure it does all three, run it once with shell before solve: on the unfinished code it should run the tests and fail on the missing work, not on the command.

Edit yourself only when solve does not fit: no command can check the change, or it is a line or two you can already see in full. When solve reports the command passing, the work is done: do not run the command again, and do not tidy what golemide wrote (warnings, style) unless the user asked for it. If solve stops without passing, read its report, then call it again with a sharper task or finish the rest yourself.

How to work:
- Look before you change anything. In a project you have not seen, start with map or tree. Read narrowly, by symbol, lines or grep, rather than whole large files.
- When you need several things you can already name (files or symbols to read, outlines, searches), ask for them all in one reply. Every call in a reply runs before the next model call, and each model call is slow: one reply with five reads is much faster than five replies with one.
- Look with tree, map, outline, search and read, never with shell (no ls, cat, grep or find): they need no permission, and shell does.
- Change a file yourself with edit, copying old exactly from what read showed, without the line numbers. Use write for a new file or a complete rewrite.
- Run tests and other commands with shell. The user may decline.
- For what the project cannot tell you, such as library documentation, an unfamiliar error or a recent release, use web_search and then web_fetch the page that answers. Say which page an answer came from, and do not present a snippet you have not read as fact.
- Every write is syntax-checked first. If an edit is refused, read the reason, look again, and retry.

When you answer:
- Be brief. Say what you changed and how you know it works. If nothing checked it, say so.
- Answer in the language the user wrote in.
"""

// ---- slash commands --------------------------------------------------------------------

type Slash = { name: String, arg: String }

fn command_of(line: String) -> Slash? = {
  let t = string.trim(line)
  if not string.starts_with(t, "/") then none
  else match string.split_once(t, " ") {
    some((n, a)) => some(Slash { name: n, arg: string.trim(a) }),
    none => some(Slash { name: t, arg: "" }),
  }
}

let COMMANDS = [
  editor.Command { name: "/help", about: "keys and commands" },
  editor.Command { name: "/clear", about: "forget the conversation, keep the project and the cost" },
  editor.Command { name: "/compact", about: "put a note in place of the conversation, to make room" },
  editor.Command { name: "/cost", about: "what this session has spent" },
  editor.Command { name: "/go", about: "approve the plan and carry it out" },
  editor.Command { name: "/goal", about: "set a goal to work until it is met, show it, or clear it" },
  editor.Command { name: "/memory", about: "where this project's notes between sessions are kept" },
  editor.Command { name: "/model", about: "show or switch the model" },
  editor.Command { name: "/yes", about: "run shell and verify commands without asking, or ask again" },
  editor.Command { name: "/plan", about: "look and plan, changing nothing until /go" },
  editor.Command { name: "/transcript", about: "where this session's messages are written" },
  editor.Command { name: "/rewind", about: "go back to before a request: the conversation, the files, or both" },
  editor.Command { name: "/resume", about: "go on with an earlier conversation in this project" },
  editor.Command { name: "/export", about: "write the conversation as a text to read (/export FILE)" },
  editor.Command { name: "/copy", about: "copy comide's last answer" },
  editor.Command { name: "/init", about: "have comide write AGENTS.md for this project" },
  editor.Command { name: "/review", about: "have comide review the changes not yet committed" },
  editor.Command { name: "/context", about: "how much of the model's room the conversation takes" },
  editor.Command { name: "/status", about: "the model, the project, the session and where things are kept" },
  editor.Command { name: "/permissions", about: "what runs without asking, what is asked about, what never runs" },
  editor.Command { name: "/hooks", about: "the checks set to run around tools" },
  editor.Command { name: "/mcp", about: "the MCP servers whose tools can be reached" },
  editor.Command { name: "/skills", about: "the skills comide can read when a task calls for one" },
  editor.Command { name: "/agents", about: "the helpers comide can hand a question to" },
  editor.Command { name: "/doctor", about: "whether the programs comide leans on are there" },
  editor.Command { name: "/exit", about: "leave" },
]

// Another name for a command that is here.
let ALIASES = [("/quit", "/exit"), ("/new", "/clear"), ("/reset", "/clear"), ("/usage", "/cost"), ("/config", "/status"),
  ("/checkpoint", "/rewind"), ("/undo", "/rewind"), ("/continue", "/resume"), ("/allowed-tools", "/permissions")]

// Commands a person may type from habit that comide has no use for, and what to do instead.
let NOT_HERE = [
  ("/login", "comide has no account: the model's key is read from ~/.config/golemide/.env or the environment"),
  ("/logout", "comide has no account: remove the model's key from ~/.config/golemide/.env to stop using it"),
  ("/terminal-setup", "nothing to set up: Shift+Enter, Alt+Enter, or \\ then Enter add a line"),
  ("/vim", "the input box has no vim mode"),
  ("/add-dir", "comide works in one project: start it with --root DIR, or from that directory"),
  ("/bug", "say it at https://github.com/O6lvl4/comide/issues"),
  ("/feedback", "say it at https://github.com/O6lvl4/comide/issues"),
  ("/release-notes", "the changes are the commits at https://github.com/O6lvl4/comide/commits/main"),
  ("/upgrade", "comide is run from its source: git pull in its directory, then almide build"),
  ("/ide", "comide has no editor plug-in"),
  ("/theme", "colour is on or off: NO_COLOR=1 turns it off"),
  ("/statusline", "the line under the input box is fixed: the model, the project, the cost"),
  ("/pr-comments", "ask for it in words: comide can run gh in the terminal"),
  ("/install-github-app", "comide has no GitHub app: it uses gh in the terminal, as you would"),
]

let KEYS_HELP = """
  enter send · shift+enter, alt+enter or \\ then enter a new line · ↑↓ history · tab complete a command
  while comide works: type and press enter to tell it more, without stopping it · esc or ctrl+c: interrupt
  ctrl+c twice or ctrl+d on an empty box: leave
"""

// `fresh` is a conversation with nothing said in it, which /clear goes back to; `start` is
// the one this run begins with, a kept one when it was taken up again. `session_id` names
// the file the conversation is kept in after every request (sessions.almd).
type Place = { setup: toolkit.Setup, fresh: options.Session, start: options.Session, transcript: String, shown_root: String, history_file: String,
  home: String, session_id: String }

// What the tools work with: the project, golemide, a scratch directory of this process's
// own, and the helpers found on this machine.
effect fn setup_of(opts: options.Options) -> Result[toolkit.Setup, String] = {
  // Made new, with a name nobody could have made first: scripts are written here and run.
  let scratch = fs.create_temp_dir("comide-")!
  let has_ctxgate = match process.output(process.ProcessCommand { cmd: "bash", args: ["-c", "command -v ctxgate"] }) { ok(st) => st.code == 0, err(_) => false }
  // Without its trailing slash, if it has one. (Until 0.9.0 an address written without
  // one was dropped for the default.)
  let searx_set = string.trim(env.get("COMIDE_SEARXNG_URL") ?? "")
  let searx_given = if searx_set == "" then "http://127.0.0.1:8888" else searx_set
  let searx = string.strip_suffix(searx_given, "/") ?? searx_given
  // The model solve runs on, golemide's defaults unless set; the strong one follows it,
  // so a run on one provider stays on it.
  let solve_model = string.trim(env.get("COMIDE_SOLVE_MODEL") ?? "")
  let solve_strong = string.trim(env.get("COMIDE_SOLVE_STRONG_MODEL") ?? "")
  let solve_timeout_s = int.parse(string.trim(env.get("COMIDE_SOLVE_TIMEOUT_S") ?? "")) ?? 300
  ok(toolkit.Setup { root: opts.root, golemide: opts.golemide, scratch: scratch, ctxgate: has_ctxgate, searx: searx,
    solve_model: solve_model, solve_strong: if solve_strong != "" then solve_strong else solve_model,
    runner: opts.runner, solve_timeout_s: solve_timeout_s, solve_notes: briefing.for_solve()!,
    skills: skills.index(skills.for_project(opts.root)!), memory_file: memory.file_for(env.get("HOME") ?? "", opts.root),
    depth: int.parse(string.trim(env.get("COMIDE_DEPTH") ?? "")) ?? 0,
    self_bin: if string.trim(env.get("COMIDE_BIN") ?? "") == "" then "comide" else string.trim(env.get("COMIDE_BIN") ?? ""),
    explore_model: if string.trim(env.get("COMIDE_EXPLORE_MODEL") ?? "") == "" then opts.model else string.trim(env.get("COMIDE_EXPLORE_MODEL") ?? "") })
}

effect fn chat(opts0: options.Options) -> Result[Int, String] = {
  let home = env.get("HOME") ?? ""
  let _ = envfile.load(envfile.dirs_for(opts0.root)!)!
  // Checked before anything else happens, so a missing key is said once, not as a
  // failed first request. The endpoint is looked up again on every call: /model can change it.
  let _ = model.endpoint_of(opts0.model)!
  let golemide_problem = solving.golemide_problem(opts0.golemide)!
  if golemide_problem != "" then options.show(opts0, ui.note_line(opts0.ui, golemide_problem))!
  // The settings (settings.almd): what may run without asking, and what may not run.
  let loaded = settings.load(opts0.root, opts0.trust_project)!
  let rule_problems = rules.problems(loaded.settings.allow + loaded.settings.ask + loaded.settings.deny)
  for line in loaded.notes + rule_problems { options.show(opts0, ui.note_line(opts0.ui, line))! }
  let has_hooks = not list.is_empty(value.as_object(loaded.settings.hooks) ?? [])
  // The programs and addresses whose tools can be reached (mcp.almd), by name only.
  let servers = mcp.servers_of(loaded.settings.mcp)
  let setup0 = { ...setup_of(opts0)!, allow_rules: loaded.settings.allow, ask_rules: loaded.settings.ask, deny_rules: loaded.settings.deny,
    hooks_json: if has_hooks then json.stringify(loaded.settings.hooks) else "",
    mcp_json: if list.is_empty(servers) then "" else json.stringify(loaded.settings.mcp) }
  // --confined: the terminal is nautra's, behind a door on this machine (confined.almd).
  // If it cannot be had, the conversation does not start.
  let door = if opts0.confined and opts0.written then some(confined.open(opts0.root, setup0.scratch, setup0.scratch + "/terminal")!) else none
  guard not (opts0.confined and not opts0.written) else err("--confined is for the written loop; it cannot be used with --loop tools")
  let setup = match door {
    some(d) => { ...setup0, door_url: d.url, door_token: d.token },
    none => setup0,
  }
  if option.is_some(door) then options.show(opts0, ui.note_line(opts0.ui, "terminal confined by nautra: writes under " + opts0.root + " and /tmp, "
    + (if string.trim(env.get("COMIDE_CONFINED_NET") ?? "") == "" then "no network" else "network: " + string.trim(env.get("COMIDE_CONFINED_NET") ?? ""))))!
  if not list.is_empty(servers) then options.show(opts0, ui.note_line(opts0.ui, "MCP servers: " + list.join(list.map(servers, (sv) => sv.name), ", ")))!
  // What a SessionStart hook prints is said to the model with the project's own notes.
  let at_start = turn.hooked(opts0, setup, "SessionStart", "", value.null(), "", "")!
  // What the project and the person wrote down for an agent (briefing.almd), after the
  // parts that do not change with the project's files, and said to the person by name.
  let notes = briefing.for_talk(opts0.root)!
  if not list.is_empty(notes) then
    options.show(opts0, ui.note_line(opts0.ui, "read " + list.join(list.map(notes, (n) => briefing.shown_path(opts0.root, n.path)), ", ")))!
  let briefed = briefing.section(opts0.root, notes)
  // The skills by name and a line each (skills.almd); their text is read when asked for.
  let known = skills.for_project(opts0.root)!
  if not list.is_empty(known) then
    options.show(opts0, ui.note_line(opts0.ui, "skills: " + list.join(list.map(known, (k) => k.name), ", ")))!
  // What was kept from earlier sessions here (memory.almd). Last, because it is the part
  // most likely to differ from one session to the next.
  let remembered = memory.section(setup.memory_file, memory.read(setup.memory_file)!)
  // Asked in writing (the default), the model is told the shape of its reply, the
  // terminal's rules and the tools as things to write (penned.almd); with --loop tools,
  // the tools are sent and this file's own words say how to use them.
  let without = (if opts0.written and not web.search_answers(setup.searx)! then ["web_search"] else [])
    + (if list.is_empty(reference.installed()!) then ["reference"] else [])
  let opening = (if opts0.written then penned.system_prompt(opts0.root, without, opts0.live) else system_prompt(opts0.root)) + "\n" + tools.project_context(setup)!
  let system = list.join(list.filter([opening, if option.is_some(door) then confined.note(opts0.root, env.get("COMIDE_CONFINED_NET") ?? "") else "",
    if opts0.written then penned.toolchains()! else "", briefed, skills.section(known), mcp.section(servers),
    if at_start.printed == "" then "" else "Said by a check the user set up to run at the start of a session:\n" + at_start.printed, remembered], (part) => part != ""), "\n\n")
  let fresh = options.Session { messages: [convo.message("system", system)], cost: 0.0, allow_shell: opts0.yes, steps: 0, check: "" }
  let _ = fs.mkdir_p(home + "/.comide")
  // A kept conversation taken up again (sessions.almd), under the system prompt just
  // written; or a new one, named by when it starts.
  let kept = if opts0.take_up then some(sessions.wanted(home, opts0.root, opts0.take_up_id)!) else none
  let begun = match kept { some(k) => sessions.taken_up(fresh.messages, k.session, opts0.yes), none => fresh }
  // --goal sets the goal the run starts with, over one a kept conversation came back with.
  let aimed = if string.trim(opts0.goal) == "" then begun else { ...begun, goal: string.trim(opts0.goal) }
  let start = { ...aimed, plan: opts0.plan }
  if opts0.plan then options.show(opts0, ui.note_line(opts0.ui, "plan mode: comide looks and plans, and changes nothing" + (if opts0.live then " until you say /go" else "")))!
  if opts0.read_only then options.show(opts0, ui.note_line(opts0.ui, "this session only looks: nothing is changed and no command is run"))!
  if start.goal != "" then options.show(opts0, ui.note_line(opts0.ui, "goal: " + start.goal))!
  match kept {
    some(k) => options.show(opts0, ui.note_line(opts0.ui, "continuing the session of " + sessions.when(k.updated_ms) + ": " + k.title
      + " · " + int.to_string(list.len(k.session.messages)) + " messages · " + convo.usd(k.session.cost)))!,
    none => (),
  }
  let place = Place { setup: setup, fresh: fresh, start: start, transcript: setup.scratch + "/transcript.json",
    shown_root: match string.strip_prefix(opts0.root, home) { some(rest) => "~" + rest, none => opts0.root },
    history_file: home + "/.comide/history", home: home,
    session_id: match kept { some(k) => if k.id == "" then int.to_string(datetime.now_ms()) else k.id, none => int.to_string(datetime.now_ms()) } }
  if not opts0.live then {
    let after = one_turn(opts0, setup, start, opts0.prompt)!
    penned.close(setup)!
    // A helper's conversation is not the person's: kept, it would be the one --continue finds.
    if setup.depth == 0 then sessions.save(home, opts0.root, opts0.model, place.session_id, after)!
    eprintln(ui.note_line(opts0.ui, "transcript: " + place.transcript + " · go on with: comide --continue"))
    ok(0)
  } else {
    // The terminal is taken over only when stdin is one; a pipe keeps the line reader.
    let saved = if term.is_tty()! then term.enter_raw()! else none
    let tui = option.is_some(saved)
    let (_, cols) = if tui then term.size()! else (24, opts0.ui.width)
    // Where what is typed while a request is worked is held (waiting.almd).
    let seated = { ...options.with_terminal(opts0, tui, ui.Ui { color: opts0.ui.color, width: int.max(40, int.min(160, cols)) }), aside: if tui then setup.scratch + "/aside" else "" }
    let outcome = match talk(seated, place) {
      ok(n) => ok(n),
      err(e) => err(e),
    }
    match saved { some(sv) => term.leave_raw(sv)!, none => () }
    // What the conversation's terminal left running ends with the conversation.
    penned.close(setup)!
    outcome
  }
}

fn status_of(opts: options.Options, place: Place, s: options.Session) -> String =
  opts.model + " · " + ui.fit_path(place.shown_root, 40) + " · " + convo.usd(s.cost)
    + (if s.allow_shell then " · commands run without asking" else "")
    + (if s.plan then " · plan mode, /go to carry it out" else "")
    + (if s.goal == "" then "" else " · goal: " + goal.brief(s.goal)) + " · /help"

// One line of the conversation from the person: the input box on a terminal, a plain
// line from a pipe. `none` is the end of the conversation.
// `draft` is what the box starts with: the request /rewind went back to before, to be
// sent again or written anew.
effect fn next_line(opts: options.Options, place: Place, s: options.Session, history: List[String], draft: String) -> String? =
  if opts.tui then {
    var got: String? = none
    var asking = true
    while asking {
      let p = editor.prompt(opts.ui, history, "ask, or tell comide what to change  ·  / for commands", status_of(opts, place, s), COMMANDS, draft)!
      if p.kind == "send" then { got = some(p.text); asking = false }
      else if p.kind == "leave" then asking = false
    }
    got
  } else {
    println("\n" + ui.prompt_rule(opts.ui))
    io.print(ui.prompt_head(opts.ui))
    options.read_input()!
  }

// Where a conversation stands between two lines from the person.
// `marks` are the conversation's requests, oldest first, each with where the conversation
// stood and where the files it changed are kept as they were (checkpoints.almd): what
// /rewind goes back to. They are written beside the copies, under the conversation's
// name, so a conversation taken up again can still go back. `id` names the file the
// conversation is kept in, which /resume changes. `keep` is where the request now being
// worked keeps its copies, `made` how many requests have been marked, and `draft` what
// the input box starts with next.
type Talk = { opts: options.Options, s: options.Session, open: Bool, marks: List[Mark] = [], id: String = "", keep: String = "", made: Int = 0, draft: String = "" }

// `at` is how many messages there were before the request, -1 when the conversation has
// since been replaced (/clear, /compact) and only the files can go back. `dir` is where
// the request's copies are, "" when nothing is kept. `said` is the request's first line,
// `text` all of it.
type Mark = { at: Int, dir: String, said: String, text: String = "" }

fn marks_file(home: String, root: String, id: String) -> String = checkpoints.base_for(home, root, id) + "/marks.json"

effect fn marks_saved(place: Place, t: Talk) -> Unit =
  if list.is_empty(list.filter(t.marks, (m) => m.dir != "")) then ()
  else {
    let _ = fs.write_text(marks_file(place.home, t.opts.root, t.id), json.stringify(value.array(list.map(t.marks, (m) =>
      value.object([("at", value.int(m.at)), ("dir", value.string(m.dir)), ("said", value.string(m.said)), ("text", value.string(m.text))])))))
    ()
  }

// The marks a conversation was left with. A place that is no longer there is dropped
// from a mark, not the mark: the conversation can still go back.
effect fn marks_of(home: String, root: String, id: String) -> List[Mark] = {
  let doc = json.parse(fs.read_text(marks_file(home, root, id)) ?? "[]") ?? value.array([])
  list.map(value.as_array(doc) ?? [], (m) => {
    let dir = value.get_string(m, "dir") ?? ""
    Mark { at: value.get_int(m, "at") ?? -1, dir: if dir != "" and fs.is_dir(dir) then dir else "", said: value.get_string(m, "said") ?? "", text: value.get_string(m, "text") ?? "" }
  })
}

// What the tools work with while a request is worked: the setup, with where to keep.
fn setup_now(t: Talk, place: Place) -> toolkit.Setup = { ...place.setup, keep_dir: t.keep }

// The commands that start a request of their own, as a line of plain words does.
let TURNING = ["/go", "/goal", "/init", "/review"]

fn starts_turn(text: String) -> Bool = match command_of(text) {
  some(c) => list.contains(TURNING, canonical(c.name)) and (c.name != "/goal" or (c.arg != "" and c.arg != "clear")),
  none => string.trim(text) != "",
}

fn canonical(name: String) -> String = match list.find(ALIASES, (a) => a.0 == name) {
  some(a) => a.1,
  none => name,
}

// A request begins: the place in the conversation is marked, and a place is made for the
// files it will change.
effect fn marked(t: Talk, place: Place, text: String) -> Talk = {
  let dir = if place.setup.depth == 0 then checkpoints.begin(place.home, t.opts.root, t.id, t.made)! else ""
  let said = list.first(string.split(string.trim(text), "\n")) ?? ""
  let next = { ...t, keep: dir, made: t.made + 1,
    marks: t.marks + [Mark { at: list.len(t.s.messages), dir: dir, said: if string.len(said) > 70 then string.take(said, 70) + "…" else said, text: string.trim(text) }] }
  marks_saved(place, next)!
  next
}

// The conversation was replaced: the marks can still put files back, nothing else.
fn files_only(marks: List[Mark]) -> List[Mark] = list.map(marks, (m) => Mark { at: -1, dir: m.dir, said: m.said, text: m.text })

effect fn talk(opts0: options.Options, place: Place) -> Result[Int, String] = {
  let u = opts0.ui
  // A conversation taken up again comes back with its marks.
  let kept_marks = if opts0.take_up then marks_of(place.home, opts0.root, place.session_id)! else []
  var t = Talk { opts: opts0, s: place.start, open: true, marks: kept_marks, id: place.session_id, keep: "", made: list.len(kept_marks), draft: "" }
  var history = if opts0.tui then editor.load_history(place.history_file)! else []
  println(ui.banner(u, opts0.model, place.shown_root))
  while t.open {
    // Measured before every prompt, so a window made wider or narrower mid-session gets
    // a box that fits it.
    if t.opts.tui then {
      println("")
      let (_, cols) = term.size()!
      t = { ...t, opts: options.with_terminal(t.opts, true, ui.Ui { color: t.opts.ui.color, width: int.max(40, int.min(160, cols)) }) }
    }
    let draft = t.draft
    t = { ...t, draft: "" }
    match next_line(t.opts, place, t.s, history, draft)! {
      none => { t = { ...t, open: false } },
      some(text) => {
        if t.opts.tui then { editor.remember(place.history_file, text)!; list.push(history, text) }
        if starts_turn(text) then { t = marked(t, place, text)! }
        t = match command_of(text) {
          some(c) => slash(t, place, Slash { name: canonical(c.name), arg: c.arg })!,
          none => if string.trim(text) == "" then t else { ...t, s: one_turn(t.opts, setup_now(t, place), t.s, text)! },
        }
        // What was typed while the request was worked and did not reach the model is
        // not lost: it is in the input box next.
        let unsaid = waiting.left(t.opts)!
        if unsaid != "" and t.draft == "" then { t = { ...t, draft: unsaid } }
        if place.setup.depth == 0 then sessions.save(place.home, t.opts.root, t.opts.model, t.id, t.s)!
      },
    }
  }
  println(ui.note_line(u, "transcript: " + place.transcript + " · session " + convo.usd(t.s.cost) + " · go on with: comide --continue"))
  ok(0)
}

// One request, worked by the loop the session was started with.
effect fn one_turn(opts: options.Options, setup: toolkit.Setup, s: options.Session, text: String) -> options.Session =
  if opts.written then penned.turn(opts, setup, s, text)! else turn.turn(opts, setup, s, text)!

// A slash command, done.
effect fn slash(t: Talk, place: Place, c: Slash) -> Talk = {
  let u = t.opts.ui
  let s = t.s
  if c.name == "/exit" or c.name == "/quit" then { ...t, open: false }
  else if c.name == "/help" then { println(ui.help(u) + (if t.opts.tui then "\n\n" + ui.dim(u, KEYS_HELP) else "")); t }
  else if c.name == "/clear" then {
    println(ui.note_line(u, "the conversation is cleared; the project and the cost so far are kept"))
    let cleared = { ...t, s: { ...s, messages: place.fresh.messages, check: "" }, marks: files_only(t.marks) }
    marks_saved(place, cleared)!
    cleared
  }
  else if c.name == "/compact" then {
    let noted = { ...compact(t, place)!, marks: files_only(t.marks) }
    marks_saved(place, noted)!
    noted
  }
  else if c.name == "/goal" then aim(t, place, c.arg)!
  else if c.name == "/plan" then {
    let on = if c.arg == "off" then false else if c.arg == "on" then true else not s.plan
    println(ui.note_line(u, if on then "plan mode: comide looks and plans, and changes nothing until you say /go" else "plan mode is off"))
    { ...t, s: { ...s, plan: on } }
  }
  else if c.name == "/go" then {
    if not s.plan then { println(ui.note_line(u, "there is no plan waiting: /plan starts one")); t }
    else {
      println(ui.note_line(u, "the plan is approved; comide carries it out"))
      { ...t, s: one_turn(t.opts, setup_now(t, place), { ...s, plan: false }, "The plan is approved. Carry it out now." + (if c.arg == "" then "" else " " + c.arg))! }
    }
  }
  else if c.name == "/cost" then { println(ui.note_line(u, "this session: " + convo.usd(s.cost) + " over " + int.to_string(s.steps) + " model calls")); t }
  else if c.name == "/model" then switch_model(t, c.arg)!
  else if c.name == "/yes" then {
    let allow = not s.allow_shell
    println(ui.note_line(u, if allow then "shell and verify commands now run without asking" else "shell and verify commands are asked about again"))
    { ...t, s: { ...s, allow_shell: allow } }
  }
  else if c.name == "/transcript" then { println(ui.note_line(u, place.transcript)); t }
  else if c.name == "/memory" then {
    let kept = string.trim(memory.read(place.setup.memory_file)!)
    println(ui.note_line(u, place.setup.memory_file + (if kept == "" then " · nothing kept yet" else " · " + int.to_string(list.len(string.split(kept, "\n"))) + " line(s); edit the file to change or remove a note")))
    t
  }
  else if c.name == "/rewind" then rewind(t, place, c.arg)!
  else if c.name == "/resume" then resume(t, place, c.arg)!
  else if c.name == "/export" then { export(t, place, c.arg)!; t }
  else if c.name == "/copy" then { copy(t)!; t }
  else if c.name == "/init" then { ...t, s: one_turn(t.opts, setup_now(t, place), s, INIT_REQUEST + (if c.arg == "" then "" else "\n\n" + c.arg))! }
  else if c.name == "/review" then { ...t, s: one_turn(t.opts, setup_now(t, place), s, REVIEW_REQUEST + (if c.arg == "" then "" else "\n\nWhat to look at in particular: " + c.arg))! }
  else { told(t, place, c)!; t }
}

let INIT_REQUEST = "Look through this project and write AGENTS.md at its root (if there is one already, improve it and keep what is still true). It is read by a coding agent before it starts work here, so write what such an agent could not see at a glance: what the project is, in a sentence or two; how to build it, run it and test it, as the exact commands, checked by running them where that is quick; how the code is laid out, and where the parts that matter are; the conventions that the code keeps and a newcomer would break; and what must not be done here. Leave out what any agent knows already, and keep it under a hundred lines."

let REVIEW_REQUEST = "Review the changes in this project that are not yet committed (git status, git diff, and the files that are new). Change nothing. Read each change in the code around it, and report what is wrong or risky, most serious first: for each, the file and the line, what goes wrong and when, and what would put it right. Say plainly when a change looks right, and say what you did not check. If nothing is uncommitted, review the last commit instead."

// The commands that only say something.
effect fn told(t: Talk, place: Place, c: Slash) -> Unit = {
  let u = t.opts.ui
  let s = t.s
  let setup = place.setup
  let lines = if c.name == "/context" then {
    let chars = list.fold(s.messages, 0, (n, m) => n + string.len(value.get_string(m, "content") ?? ""))
    [int.to_string(list.len(s.messages)) + " messages, about " + int.to_string(chars / 1000) + "k characters"
      + (if s.last_in > 0 then "; the last call sent " + int.to_string(s.last_in / 1000) + "k tokens" else ""),
     "a note takes the conversation's place above " + int.to_string(handover.limit()! / 1000) + "k tokens (COMIDE_COMPACT_TOKENS); /compact does it now"]
  }
  else if c.name == "/status" then [
    "model: " + t.opts.model + " · " + (if t.opts.written then "asked in writing, one terminal" else "tools sent as tool calls (--loop tools)")
      + (if setup.door_url != "" then " · terminal confined by nautra" else ""),
    "project: " + t.opts.root,
    "session: " + t.id + " · " + convo.usd(s.cost) + " over " + int.to_string(s.steps) + " model calls · kept in " + sessions.dir_for(place.home, t.opts.root),
    "settings: " + config_dir()! + "/comide/settings.json, " + settings.project_file(t.opts.root),
    "notes between sessions: " + setup.memory_file,
    "this run's messages: " + place.transcript,
  ]
  else if c.name == "/permissions" then
    ["run without asking: " + listed(setup.allow_rules), "asked about: " + listed(setup.ask_rules), "never run: " + listed(setup.deny_rules),
     (if s.allow_shell then "this session: shell and verify commands run without asking (/yes to ask again)" else "this session: a command no rule speaks of is asked about (/yes to stop asking)"),
     "written in: " + config_dir()! + "/comide/settings.json, " + settings.project_file(t.opts.root)]
  else if c.name == "/hooks" then (if setup.hooks_json == "" then ["no hooks are set; they are written under \"hooks\" in the settings (/status says where)"] else string.split(json.stringify_pretty(json.parse(setup.hooks_json) ?? value.null()), "\n"))
  else if c.name == "/mcp" then {
    let servers = if setup.mcp_json == "" then [] else mcp.servers_of(json.parse(setup.mcp_json) ?? value.null())
    if list.is_empty(servers) then ["no MCP servers are set; they are written under \"mcpServers\" in the settings (/status says where)"]
    else list.map(servers, (sv) => sv.name + ": " + (if sv.http then sv.url else string.trim(sv.command + " " + list.join(sv.args, " "))))
  }
  else if c.name == "/skills" then (if list.is_empty(setup.skills) then ["no skills were found (a skill is a directory with a SKILL.md, in .comide/skills or ~/.config/comide/skills)"] else list.map(setup.skills, (k) => k.0 + ": " + k.1))
  else if c.name == "/agents" then ["comide has one helper: explore, which it hands a question about the code to, so that the reading does not fill this conversation.",
    "It runs read-only on " + setup.explore_model + " (COMIDE_EXPLORE_MODEL), and its cost is counted in the session's. There are no helpers to define."]
  else if c.name == "/doctor" then doctor(t, place)!
  else match list.find(NOT_HERE, (n) => n.0 == c.name) {
    some(n) => [n.0 + " is not a command here: " + n.1],
    none => ["no command " + c.name + "; /help lists them"],
  }
  for line in lines { println(ui.note_line(u, line)) }
}

fn listed(rules_: List[String]) -> String = if list.is_empty(rules_) then "(nothing)" else list.join(rules_, ", ")

effect fn config_dir() -> String = {
  let config = env.get("XDG_CONFIG_HOME") ?? ""
  if config == "" then (env.get("HOME") ?? "") + "/.config" else config
}

// /doctor: the programs comide leans on, each there or not, and what is lost without it.
effect fn doctor(t: Talk, place: Place) -> List[String] = {
  let there = (name: String) => match process.output(process.ProcessCommand { cmd: "bash", args: ["-c", "command -v \"$1\"", "comide", name] }) { ok(st) => st.code == 0, err(_) => false }
  let line = (name: String, ok_: Bool, without: String) => (if ok_ then "ok       " else "missing  ") + name + (if ok_ then "" else ": " + without)
  let golemide_problem = solving.golemide_problem(t.opts.golemide)!
  [line("the model (" + t.opts.model + ")", result.is_ok(model.endpoint_of(t.opts.model)), "no key or no such model"),
   line("golemide", golemide_problem == "", if golemide_problem == "" then "" else golemide_problem),
   line("hew", there("hew"), "reading falls back to plain files"),
   line("gramide", there("gramide"), "golemide checks syntax with less"),
   line("ctxgate", place.setup.ctxgate, "long command output is cut, not summarised"),
   line("nautra", there("nautra") or string.trim(env.get("NAUTRA") ?? "") != "", "--confined cannot be used"),
   line("a search engine at " + place.setup.searx, web.search_answers(place.setup.searx)!, "web_search is not offered"),
   line("almide", there("almide"), "the reference tool has nothing to say about Almide")]
}

// /export: the conversation as a text to read (exported.almd), in a file.
effect fn export(t: Talk, place: Place, arg: String) -> Unit = {
  let u = t.opts.ui
  if not list.any(t.s.messages, (m) => (value.get_string(m, "role") ?? "") == "user") then println(ui.note_line(u, "there is no conversation to write yet"))
  else {
    let text = exported.markdown(sessions.title_of(t.s.messages), t.opts.model, place.shown_root, sessions.when(datetime.now_ms()), t.s.messages)
    let own = arg == ""
    let file = if own then place.home + "/.comide/exports/" + t.id + ".md" else absolute(match string.strip_prefix(arg, "~/") { some(rest) => place.home + "/" + rest, none => arg }, t.opts.root)
    if own then { let _ = fs.mkdir_p(place.home + "/.comide/exports") }
    match fs.write_text(file, text) {
      ok(_) => {
        // Under comide's own directory it is the person's only, like the session it came from.
        if own then { let _ = process.exec("chmod", ["600", file]) }
        println(ui.note_line(u, "written to " + file + " (" + int.to_string(list.len(string.split(text, "\n"))) + " lines; results are cut, the system prompt is left out)"))
      },
      err(e) => println(ui.note_line(u, "could not write " + file + ": " + e)),
    }
  }
}

// /copy: comide's last answer, to the clipboard.
effect fn copy(t: Talk) -> Unit = {
  let u = t.opts.ui
  match list.last(list.filter(t.s.messages, (m) => (value.get_string(m, "role") ?? "") == "assistant" and string.trim(value.get_string(m, "content") ?? "") != "")) {
    none => println(ui.note_line(u, "comide has not answered yet")),
    some(m) => {
      let text = exported.reply(value.get_string(m, "content") ?? "")
      let program = "if command -v pbcopy > /dev/null; then pbcopy; elif command -v wl-copy > /dev/null; then wl-copy; elif command -v xclip > /dev/null; then xclip -selection clipboard; else exit 3; fi"
      let code = match process.output(process.ProcessCommand { cmd: "bash", args: ["-c", program], stdin: text, timeout_ms: 5000 }) { ok(st) => st.code, err(_) => 1 }
      println(ui.note_line(u, if code == 0 then "copied (" + int.to_string(list.len(string.split(text, "\n"))) + " lines)"
        else if code == 3 then "no clipboard program was found (pbcopy, wl-copy or xclip); /export writes a file instead" else "the clipboard did not take it"))
    },
  }
}

// One of a few, chosen: a menu on a terminal; elsewhere nothing is chosen (-1) and the
// caller says how to choose by name.
effect fn chosen(t: Talk, question: String, options_: List[String]) -> Int =
  if t.opts.tui then editor.choose(t.opts.ui, question, options_)! else -1

// /rewind [N] [conversation|files|both]: back to before the Nth request from the end.
effect fn rewind(t: Talk, place: Place, arg: String) -> Talk = {
  let u = t.opts.ui
  let words = list.filter(string.split(arg, " "), (w) => w != "")
  let count = list.len(t.marks)
  let recent = list.take(list.reverse(t.marks), 9)
  if count == 0 then { println(ui.note_line(u, "there is nothing to go back to yet: /rewind goes back to before a request of this conversation")); t }
  else {
    let named = int.parse(list.first(words) ?? "") ?? 0
    let n = if named > 0 then named else 1 + chosen(t, "Go back to before which request?", list.map(recent, (m) => m.said))!
    if n < 1 or n > count then {
      if named == 0 and not t.opts.tui then {
        println(ui.note_line(u, "/rewind N goes back to before one of these (add `conversation` or `files` for one of the two):"))
        var i = 1
        for m in recent { println(ui.note_line(u, "  " + int.to_string(i) + ". " + m.said)); i = i + 1 }
      } else if named > count then println(ui.note_line(u, "there are only " + int.to_string(count) + " requests to go back over"))
      t
    } else {
      let mark = list.get(t.marks, count - n) ?? Mark { at: -1, dir: "", said: "", text: "" }
      // The requests to go back over, the latest first, and what they kept: a file kept
      // by more than one is named once.
      let dirs = list.filter(list.map(list.reverse(list.drop(t.marks, count - n)), (m) => m.dir), (d) => d != "")
      var differ: List[String] = []
      for d in list.reverse(dirs) {
        for line in checkpoints.kept(d)! { if not list.any(differ, (have) => string.drop(have, 2) == string.drop(line, 2)) then list.push(differ, line) }
      }
      // Changed since by something that did not name them: said, not put back.
      let loose = if mark.dir == "" then [] else checkpoints.loose(mark.dir, t.opts.root, differ)!
      let can_talk = mark.at >= 0 and mark.at <= list.len(t.s.messages)
      let can_files = not list.is_empty(differ)
      let files_label = "the files (" + (if not can_files then "none were kept" else int.to_string(list.len(differ)) + " kept") + ")"
      let word = list.get(words, 1) ?? ""
      let what = if word == "conversation" or word == "files" or word == "both" then word
        else if not t.opts.tui then "both"
        else list.get(["both", "conversation", "files", ""], chosen(t, "Put back what?", ["The conversation and " + files_label, "The conversation only", "Only " + files_label, "Nothing"])!) ?? ""
      if what == "" then { println(ui.note_line(u, "nothing was put back")); t }
      else {
        let do_files = (what == "both" or what == "files") and can_files
        let do_talk = (what == "both" or what == "conversation") and can_talk
        let restored = if do_files then checkpoints.restore(dirs, t.opts.root) else ok(())
        match restored {
          err(e) => { println(ui.note_line(u, e)); t },
          ok(_) => {
            if do_files then {
              println(ui.note_line(u, "put back as they were before that request (M changed, A made since and now removed):"))
              for d in list.take(differ, 12) { println(ui.note_line(u, "  " + d)) }
              if list.len(differ) > 12 then println(ui.note_line(u, "  … and " + int.to_string(list.len(differ) - 12) + " more"))
            } else if what != "conversation" then println(ui.note_line(u, "no files were kept for that request: comide changed none it could name, or COMIDE_CHECKPOINTS=0"))
            if what != "conversation" and not list.is_empty(loose) then {
              println(ui.note_line(u, "changed since and not kept, so left as they are (a command changed them without naming them, or you did):"))
              for l in list.take(loose, 8) { println(ui.note_line(u, "  " + l)) }
              if list.len(loose) > 8 then println(ui.note_line(u, "  … and " + int.to_string(list.len(loose) - 8) + " more"))
            }
            if do_talk then println(ui.note_line(u, "the conversation is back to before: " + mark.said))
            else if what != "files" then println(ui.note_line(u, "the conversation has been replaced since (/clear or /compact) and cannot go back; it stays as it is"))
            if do_talk then {
              let back = list.take(t.s.messages, mark.at)
              // Back before the first request there is nothing to keep, and a conversation
              // with nothing asked is not saved over the old file: the file goes, or
              // --continue would bring back what was just undone.
              if not list.any(back, (m) => (value.get_string(m, "role") ?? "") == "user") then { let _ = fs.remove(sessions.dir_for(place.home, t.opts.root) + "/" + t.id + ".json") }
              // The request comes back to the input box, to be sent again or written anew.
              if not t.opts.tui and mark.text != "" then println(ui.note_line(u, "the request was: " + mark.said))
              let back_to = { ...t, s: { ...t.s, messages: back, check: "", last_in: 0 }, marks: list.take(t.marks, count - n), draft: mark.text }
              marks_saved(place, back_to)!
              back_to
            } else t
          },
        }
      }
    }
  }
}

// /resume [ID]: an earlier conversation of this project, in place of this one.
effect fn resume(t: Talk, place: Place, arg: String) -> Talk = {
  let u = t.opts.ui
  let ids = list.take(list.filter(sessions.ids(place.home, t.opts.root)!, (id) => id != t.id), 9)
  let kept = list.filter_map(ids, (id) => result.to_option(sessions.load(sessions.dir_for(place.home, t.opts.root) + "/" + id + ".json")))
  let label = (k: sessions.Kept) => sessions.when(k.updated_ms) + "  " + k.title
  if arg == "" and list.is_empty(kept) then { println(ui.note_line(u, "there is no earlier conversation in this project")); t }
  else {
    let wanted = if arg != "" then result.to_option(sessions.wanted(place.home, t.opts.root, arg)) else list.get(kept, chosen(t, "Go on with which conversation?", list.map(kept, label))!)
    match wanted {
      none => {
        if arg != "" then println(ui.note_line(u, "no session " + arg + " in this project"))
        else if not t.opts.tui then {
          println(ui.note_line(u, "/resume ID goes on with one of these:"))
          for k in kept { println(ui.note_line(u, "  " + k.id + "  " + label(k))) }
        }
        t
      },
      some(k) => {
        println(ui.note_line(u, "going on with the conversation of " + label(k) + " · " + int.to_string(list.len(k.session.messages)) + " messages · " + convo.usd(k.session.cost)))
        // It comes back with its own marks; this conversation's stay with its own name.
        let id = if k.id == "" then t.id else k.id
        let its = if k.id == "" then [] else marks_of(place.home, t.opts.root, id)!
        { ...t, s: sessions.taken_up(place.fresh.messages, k.session, t.s.allow_shell), id: id, marks: its, made: list.len(its), keep: "" }
      },
    }
  }
}

// /goal: show the goal, clear it, or set one and start on it (goal.almd).
effect fn aim(t: Talk, place: Place, arg: String) -> Talk = {
  let u = t.opts.ui
  if arg == "" then {
    println(ui.note_line(u, if t.s.goal == "" then "no goal is set; /goal TEXT sets one, and comide works until it is met" else "goal: " + t.s.goal + "   (/goal clear to drop it)"))
    t
  } else if arg == "clear" then {
    println(ui.note_line(u, if t.s.goal == "" then "no goal was set" else "the goal is cleared"))
    { ...t, s: { ...t.s, goal: "" } }
  } else {
    println(ui.note_line(u, "goal: " + arg))
    { ...t, s: one_turn(t.opts, setup_now(t, place), { ...t.s, goal: arg }, goal.opening(arg))! }
  }
}

// /compact: the hand-over note now, without waiting for the conversation to outgrow the
// model (handover.almd).
effect fn compact(t: Talk, place: Place) -> Talk = {
  let u = t.opts.ui
  if list.len(t.s.messages) < 3 then { println(ui.note_line(u, "there is nothing to make shorter yet")); t }
  else match handover.written(t.opts.model, t.opts.effort, place.setup.scratch, t.s.messages, "", t.s.goal) {
    err(e) => { println(ui.note_line(u, "a note could not be written: " + string.take(e, 200))); t }
    ok(n) => {
      println(ui.note_line(u, "a note now stands in place of the conversation (" + int.to_string(n.before / 1000) + "k → "
        + int.to_string(n.after / 1000) + "k characters, " + convo.usd(n.cost_usd) + "); what it replaced is in " + n.kept_at))
      { ...t, s: { ...t.s, messages: n.messages, cost: t.s.cost + n.cost_usd, last_in: 0 } }
    }
  }
}

effect fn switch_model(t: Talk, to: String) -> Talk = {
  let u = t.opts.ui
  if to == "" then { println(ui.note_line(u, "model: " + t.opts.model + "   (/model cf:glm-5.3-flash, /model claude, /model openai:gpt-5 to switch)")); t }
  else match model.endpoint_of(to) {
    ok(_) => { println(ui.note_line(u, "model: " + to)); { ...t, opts: options.with_model(t.opts, to) } },
    err(e) => { println(ui.note_line(u, e + "; still " + t.opts.model)); t },
  }
}

// The command line, read once from the left: an option that takes a value takes the
// word after it, whatever that word is, and that word is then nobody's option. Reading
// the list by asking "is --x anywhere in it" let the request itself be an option: a
// request that was the text `--trust-project` trusted the project (found in review,
// 2026-11-18; the explore tool passes a model's words as the request).
let TAKES_VALUE = ["-p", "--root", "--model", "--effort", "--max-steps", "--golemide", "--runner", "--resume", "--goal", "--loop"]

type Args = { flags: List[String], values: List[(String, String)] }

fn read_args(args: List[String]) -> Args = {
  var flags: List[String] = []
  var values: List[(String, String)] = []
  var i = 0
  while i < list.len(args) {
    let a = args[i]
    if list.contains(TAKES_VALUE, a) then {
      match list.get(args, i + 1) { some(v) => list.push(values, (a, v)), none => () }
      i = i + 2
    } else {
      list.push(flags, a)
      i = i + 1
    }
  }
  Args { flags: flags, values: values }
}

fn opt(a: Args, name: String) -> String? = option.map(list.find(a.values, (row) => row.0 == name), (row) => row.1)

fn has(a: Args, name: String) -> Bool = list.contains(a.flags, name)

fn absolute(root: String, cwd: String) -> String = {
  let r = string.strip_suffix(root, "/") ?? root
  if string.starts_with(root, "/") then (if r == "" then "/" else r)
  else if r == "" or r == "." then cwd
  else cwd + "/" + (string.strip_prefix(r, "./") ?? r)
}

let CHAT_USAGE = """
comide [run PROMPT | -p PROMPT] [--continue | --resume ID] [--root DIR] [--model M] [--effort E] [--yes] [--max-steps N] [--golemide PATH] [--runner PROG]

  run PROMPT       one request, answered, then exit; without it, a conversation
  -p PROMPT        the same as run
  --continue       go on with this project's most recent conversation
  --resume ID      go on with a given one; they are kept in ~/.comide/sessions
  --goal TEXT      what the session is for: comide goes on until the model says it is
                   met, and the goal is kept with the conversation
  --root DIR       the project (default: the working directory)
  --model M        which model thinks, as PROVIDER:MODEL (default cf:glm-5.3)
                     cf:glm-5.3, cf:glm-5.3-flash, ...   Cloudflare Workers AI
                     openai:gpt-5, openrouter:..., ollama:qwen3, ...
                                     any OpenAI-compatible service: NAME_API_KEY, and
                                     NAME_BASE_URL for one comide does not know
                     claude, claude:opus  Claude Code's `claude -p`, on your Claude login
  --effort E       reasoning effort, sent to Cloudflare only: low (default), medium, high
  --plan           plan mode: look and answer with a plan; nothing is changed and no
                   command is run. /go in a conversation approves it; after `run`,
                   `comide run "go ahead" --continue` carries it out
  --read-only      only look, for the whole run: no file changed, no command run
  --confined       the terminal is nautra's: a command the model writes can write only
                   under the project and /tmp, read only the project and the system's
                   directories, and reach no network ($COMIDE_CONFINED=1). Needs nautra
                   and build/comide-shell (nautra/build.sh). $COMIDE_CONFINED_NET names
                   hosts it may reach ("pypi.org:443 files.pythonhosted.org:443")
  --loop tools     the loop comide had before 0.7: the tools are sent to the model as
                   tool calls, and its shell starts afresh for every command
                   ($COMIDE_LOOP). The default, written, asks the model to answer every
                   step in writing and gives it one terminal that lasts; the tools are
                   the same ones
  --yes            run shell and verify commands without asking
  --trust-project  use the allow rules and hooks in this project's .comide/settings.json,
                   as the file is now; without it only its ask and deny rules are used
  --max-steps N    model calls per request before it stops to ask (default 40)
  --golemide PATH  the golemide binary (default: $COMIDE_GOLEMIDE, else golemide on PATH)
  --runner PROG    run every tool's command as `PROG KIND -- CMD ARGS...` (default:
                   $COMIDE_RUNNER, else none); KIND is read, shell or solve. aitrium uses
                   it to confine each call and keep the keys out of it

solve runs on golemide's own models (cf:glm-5.3-flash, escalating to cf:glm-5.3);
COMIDE_SOLVE_MODEL and COMIDE_SOLVE_STRONG_MODEL choose others, with the same names.
A solve may take COMIDE_SOLVE_TIMEOUT_S seconds (default 300); golemide stops in time to
say how far it got.

A conversation that outgrows the model is replaced by a note about it, written by
COMIDE_SUMMARY_MODEL (default: the conversation's model) once a call's input passes
COMIDE_COMPACT_TOKENS (default 120000).

In a conversation: /help /clear /compact /cost /go /goal /memory /model /plan /yes /transcript /exit
"""

effect fn cli(raw: List[String]) -> Int = {
  let args = read_args(raw)
  // A helper another comide started (exploring.almd) is given a model's words as its
  // request and must not be able to do what only the person may: trust a project.
  let helper = (int.parse(string.trim(env.get("COMIDE_DEPTH") ?? "")) ?? 0) > 0
  if has(args, "--help") or has(args, "-h") then { println(CHAT_USAGE); 0 }
  else {
    let prompt = opt(args, "-p") ?? ""
    let opts = options.Options {
      root: absolute(opt(args, "--root") ?? ".", env.cwd() ?? "."),
      // The conversation runs on the full model: it is where the request is understood,
      // the tools are chosen and the answer is written, a few calls a turn. The repair
      // loop behind `solve` stays on golemide's own default, flash, which is where the
      // many cheap calls are and where golemide was measured.
      model: opt(args, "--model") ?? "cf:glm-5.3",
      effort: opt(args, "--effort") ?? "low",
      max_steps: int.parse(opt(args, "--max-steps") ?? "40") ?? 40,
      max_tokens: 16384,
      yes: has(args, "--yes"),
      prompt: prompt,
      golemide: opt(args, "--golemide") ?? (env.get("COMIDE_GOLEMIDE") ?? "golemide"),
      live: prompt == "",
      tui: false,
      ui: ui.detect()!,
      runner: opt(args, "--runner") ?? (env.get("COMIDE_RUNNER") ?? ""),
      take_up: has(args, "--continue") or option.is_some(opt(args, "--resume")),
      take_up_id: opt(args, "--resume") ?? "",
      goal: opt(args, "--goal") ?? "",
      trust_project: has(args, "--trust-project") and not helper,
      plan: has(args, "--plan"),
      read_only: has(args, "--read-only") or helper,
      written: (opt(args, "--loop") ?? (env.get("COMIDE_LOOP") ?? "")) != "tools",
      confined: has(args, "--confined") or (env.get("COMIDE_CONFINED") ?? "") == "1",
    }
    match chat(opts) { ok(code) => code, err(e) => { eprintln(e); 2 } }
  }
}

test "an option's value is its value, even when it looks like an option" {
  let a = read_args(["-p", "--trust-project", "--read-only", "--root", "/w", "--yes"])
  assert_eq(opt(a, "-p"), some("--trust-project"))
  assert(not has(a, "--trust-project"))
  assert(has(a, "--read-only"))
  assert(has(a, "--yes"))
  assert_eq(opt(a, "--root"), some("/w"))
  assert_eq(opt(read_args(["-p", "--model"]), "--model"), none)
  assert_eq(opt(read_args(["--resume"]), "--resume"), none)
}

test "a line starting with a slash is a command" {
  assert_eq(command_of("/model cf:glm-5.3"), some(Slash { name: "/model", arg: "cf:glm-5.3" }))
  assert_eq(command_of("  /exit "), some(Slash { name: "/exit", arg: "" }))
  assert_eq(command_of("fix the tests"), none)
}

test "a relative root is taken from the working directory" {
  assert_eq(absolute(".", "/w/p"), "/w/p")
  assert_eq(absolute("sub/", "/w/p"), "/w/p/sub")
  assert_eq(absolute("/abs", "/w/p"), "/abs")
}
