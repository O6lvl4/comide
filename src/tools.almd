// The tools the conversation can call, each one a program that already exists:
//
//   read, outline, search, tree   hew           reads code by symbol, range or match
//   map                           gramide map   ranks files against a task
//   edit, write                   golemide edit the replacement ladder and the syntax gate
//   solve                         golemide solve --json   edit, verify, retry until it passes
//   shell                         ctxgate exec  long runner output summarised, exit kept
//
// None of them is reimplemented here. What this module adds is the schema the model
// sees and the dispatch; what every tool shares is toolkit.almd, golemide's part
// solving.almd, and the web web.almd.

import json
import self.toolkit
import self.solving
import self.web
import self.skills
import self.memory
import self.exploring
import self.mcp
import fs

let SHELL_TIMEOUT_S = 300

// ---- the schema the model sees -------------------------------------------------------

fn prop(name: String, kind: String, desc: String) -> (String, Value) =
  (name, value.object([("type", value.string(kind)), ("description", value.string(desc))]))

fn tool(name: String, desc: String, props: List[(String, Value)], required: List[String]) -> Value =
  value.object([("type", value.string("function")), ("function", value.object([
    ("name", value.string(name)),
    ("description", value.string(desc)),
    ("parameters", value.object([("type", value.string("object")), ("properties", value.object(props)),
      ("required", value.array(list.map(required, (r) => value.string(r))))])),
  ]))])

fn definitions() -> List[Value] = [
  tool("read", "Read a file with line numbers. Narrow it with symbol (one function or type by name), lines (\"A-B\"), or grep (a regex) with around lines of context. Read a file before editing it.",
    [prop("path", "string", "file path, relative to the project root"), prop("symbol", "string", "function, method or type name"),
     prop("lines", "string", "line range, e.g. \"40-90\""), prop("grep", "string", "regex; matching lines with context"),
     prop("around", "integer", "context lines around each grep match (default 3)")], ["path"]),
  tool("outline", "List the functions and types in a file, or in every file under a directory, with their line ranges.",
    [prop("path", "string", "file or directory, relative to the project root")], ["path"]),
  tool("search", "Search file contents for a regex. Each hit is labelled with the function it is in.",
    [prop("pattern", "string", "regex"), prop("path", "string", "file or directory to search (default: the whole project)")], ["pattern"]),
  tool("tree", "The directory tree, without version-control, build and dependency directories.",
    [prop("path", "string", "directory (default: the project root)"), prop("depth", "integer", "levels to show (default 3)")], []),
  tool("map", "Rank the project's files by relevance to a task and list their main symbols. Useful first in a project you have not seen.",
    [prop("task", "string", "what you are trying to do")], ["task"]),
  tool("edit", "Replace text in a file. Copy old exactly from what read showed, without the line-number prefix; it is matched exactly first, then with indentation and whitespace loosened, and must match one place. The syntax of the result is checked before it is written: an edit that breaks it is refused and nothing is written.",
    [prop("path", "string", "file to change"), prop("old", "string", "the text to replace"), prop("new", "string", "the replacement")], ["path", "old", "new"]),
  tool("write", "Create a file, or replace a file's whole content. The syntax is checked before it is written. To implement or fix code that a command can check, use solve instead.",
    [prop("path", "string", "file to write"), prop("content", "string", "the complete file content")], ["path", "content"]),
  tool("shell", "Run a shell command in the project root: tests, builds, git. Returns the exit status and output. Long output is shortened for you, so do not pipe it through head or tail. The user may decline to run it.",
    [prop("command", "string", "the command line"), prop("timeout_s", "integer", "seconds before it is stopped (default 300)")], ["command"]),
  tool("solve", "The default way to change code whenever a command can check the change (tests, a build). Hands the change to golemide, which reads the code, edits it, runs verify, and retries with the failure until verify exits 0. Call it before writing the implementation yourself. Returns the status, the files changed and the end of the last verify output.",
    [prop("task", "string", "the change, stated precisely"), prop("verify", "string", "command whose exit status 0 means done, taken from how the project runs its tests, e.g. \"cargo test\""),
     prop("attempts", "integer", "edit/verify rounds before giving up (default 6)")], ["task", "verify"]),
  tool("web_search", "Search the web. Use it for what the project cannot tell you: library and API documentation, error messages, versions, recent changes. Returns titles, addresses and snippets; read the page with web_fetch before relying on it.",
    [prop("query", "string", "the search query"), prop("max_results", "integer", "how many results (default 8)")], ["query"]),
  tool("web_fetch", "Read a web page on the public internet as text: a result from web_search, or an address the user gave. Long pages are shortened, and the whole text is kept in a file you can read with read (lines or grep).",
    [prop("url", "string", "the http or https address")], ["url"]),
  tool("skill", "Open a skill by name: a procedure written down for one kind of task. The skills that exist are listed at the start of the conversation; when a request matches one, open it before doing the work and follow it.",
    [prop("name", "string", "the skill's name, as listed")], ["name"]),
  tool("explore", "Hand a question about the code to a helper that looks on its own and comes back with the answer. Use it when answering would take many reads whose output you do not need to keep: where something is handled, how a feature works across files, what calls what. The helper sees none of this conversation, so put everything it needs in the task, and say what the answer should contain (paths, line numbers, names). It cannot change files or run commands. For one file or one symbol you can already name, read it yourself.",
    [prop("task", "string", "the question, with everything the helper needs to know to answer it")], ["task"]),
  tool("mcp_tools", "List what an MCP server offers: its tools, a line each. The servers that exist are named at the start of the conversation. Without a server, lists the servers.",
    [prop("server", "string", "the server's name")], []),
  tool("mcp_describe", "One MCP tool in full: what it does and the arguments it takes, as a JSON schema. Look before the first call to a tool.",
    [prop("server", "string", "the server's name"), prop("tool", "string", "the tool's name, as mcp_tools listed it")], ["server", "tool"]),
  tool("mcp_call", "Call a tool on an MCP server. The user may decline.",
    [prop("server", "string", "the server's name"), prop("tool", "string", "the tool's name"),
     prop("arguments", "object", "the tool's arguments, as mcp_describe showed them")], ["server", "tool"]),
  tool("remember", "Keep one fact for later sessions in this project: a correction the user made, a preference they stated, or where something is that took steps to find. One sentence that will still make sense on its own. Not what the code or its history already says, and not what only matters to this request.",
    [prop("note", "string", "the fact, in one sentence")], ["note"]),
]

// ---- running them --------------------------------------------------------------------

effect fn read(s: toolkit.Setup, a: Value) -> toolkit.ToolResult = {
  var args = [toolkit.under_root(s, toolkit.str_arg(a, "path"))]
  if toolkit.str_arg(a, "symbol") != "" then { args = args + ["--symbol", toolkit.str_arg(a, "symbol")] }
  if toolkit.str_arg(a, "lines") != "" then { args = args + ["--lines", toolkit.str_arg(a, "lines")] }
  if toolkit.str_arg(a, "grep") != "" then { args = args + ["--grep", toolkit.str_arg(a, "grep"), "--around", int.to_string(toolkit.int_arg(a, "around", 3))] }
  let (_, out) = toolkit.run_in(s, "read", "hew", args, 60)!
  toolkit.said(toolkit.capped(s, toolkit.relative(s, out))!, toolkit.count_lines(out))
}

effect fn hew_listing(s: toolkit.Setup, sub: String, a: Value) -> toolkit.ToolResult = {
  let target = toolkit.under_root(s, toolkit.str_arg(a, "path"))
  let args = if sub == "tree" then ["tree", target, "--depth", int.to_string(toolkit.int_arg(a, "depth", 3))]
    else if sub == "search" then ["grep", toolkit.str_arg(a, "pattern"), target]
    else ["outline", target]
  let (_, out) = toolkit.run_in(s, "read", "hew", args, 60)!
  toolkit.said(toolkit.capped(s, toolkit.relative(s, out))!, toolkit.count_lines(out))
}

effect fn map(s: toolkit.Setup, a: Value) -> toolkit.ToolResult = {
  let (_, out) = toolkit.run_in(s, "read", "gramide", ["map", s.root, "--budget", "3000", "--task", toolkit.str_arg(a, "task")], 120)!
  toolkit.said(toolkit.capped(s, toolkit.relative(s, out))!, toolkit.count_lines(out))
}

effect fn shell(s: toolkit.Setup, a: Value) -> toolkit.ToolResult = {
  let command = toolkit.str_arg(a, "command")
  let line = "cd " + toolkit.shell_quote(s.root) + " && " + command
  // pipefail: measured on the first conversation, `npm test 2>&1 | tail -30` in a
  // project with no package.json came back exit 0, tail's status, not npm's.
  let bash = ["bash", "-o", "pipefail", "-c", line]
  let (code, out) = if s.ctxgate then toolkit.run_in(s, "shell", "ctxgate", ["exec", "--"] + bash, toolkit.int_arg(a, "timeout_s", SHELL_TIMEOUT_S))!
    else toolkit.run_in(s, "shell", "bash", list.drop(bash, 1), toolkit.int_arg(a, "timeout_s", SHELL_TIMEOUT_S))!
  let status = if code == -1 then "did not finish: " else "exit " + int.to_string(code) + "\n"
  let brief = if code == -1 then "did not finish: " + toolkit.first_line_of(out, 80) else "exit " + int.to_string(code) + " · " + toolkit.count_lines(out)
  let hint = if code != 0 and code != -1 and solving.checks_work(command) then solving.solve_hint(command) else ""
  if code == 0 then toolkit.said(toolkit.capped(s, status + out)!, brief) else toolkit.failed(toolkit.capped(s, status + out)! + hint, brief)
}

effect fn run(s: toolkit.Setup, name: String, arguments: String) -> toolkit.ToolResult =
  match json.parse(if string.trim(arguments) == "" then "{}" else arguments) {
    err(e) => toolkit.failed("the arguments were not valid JSON (" + e + "): " + string.take(arguments, 300), "the arguments were not valid JSON"),
    ok(a) => match looked(s, name, a)! {
      some(r) => r,
      none => changed(s, name, a)!,
    },
  }

// The tools that only look: hew and gramide.
effect fn looked(s: toolkit.Setup, name: String, a: Value) -> toolkit.ToolResult? =
  if name == "read" then some(read(s, a)!)
  else if name == "outline" or name == "tree" or name == "search" then some(hew_listing(s, name, a)!)
  else if name == "map" then some(map(s, a)!)
  else if name == "skill" then some(skill(s, a)!)
  else if name == "remember" then some(remember(s, a)!)
  else if name == "explore" then some(exploring.explore(s, a)!)
  else if name == "mcp_tools" or name == "mcp_describe" then some(mcp_look(s, name, a)!)
  else none

// What a server offers, or one of its tools in full (mcp.almd). Both are the server's
// answer to tools/list, asked for when wanted and not before.
effect fn mcp_look(s: toolkit.Setup, name: String, a: Value) -> toolkit.ToolResult = {
  let servers = mcp.servers_of(mcp.parsed(s.mcp_json))
  let server = toolkit.str_arg(a, "server")
  if server == "" then toolkit.said(if list.is_empty(servers) then "No MCP servers are set up." else "MCP servers: " + list.join(list.map(servers, (sv) => sv.name), ", "), int.to_string(list.len(servers)) + " server(s)")
  else match mcp.named(servers, server) {
    err(e) => toolkit.failed(e, "no such server"),
    ok(sv) => match mcp.ask(s.scratch, s.root, sv, "tools/list", value.null()) {
      err(e) => toolkit.failed(e, toolkit.first_line_of(e, 80)),
      ok(listed) => if name == "mcp_tools" then toolkit.said(toolkit.capped(s, mcp.tools_listed(listed))!, toolkit.count_lines(mcp.tools_listed(listed)))
        else match mcp.tool_described(listed, toolkit.str_arg(a, "tool")) {
          some(text) => toolkit.said(toolkit.capped(s, text)!, toolkit.count_lines(text)),
          none => toolkit.failed("The server " + server + " has no tool called " + toolkit.str_arg(a, "tool") + ". Its tools:\n" + mcp.tools_listed(listed), "no such tool"),
        },
    },
  }
}

effect fn mcp_call(s: toolkit.Setup, a: Value) -> toolkit.ToolResult =
  match mcp.named(mcp.servers_of(mcp.parsed(s.mcp_json)), toolkit.str_arg(a, "server")) {
    err(e) => toolkit.failed(e, "no such server"),
    ok(sv) => {
      let arguments = match value.get(a, "arguments") { some(v) => v, none => value.object([]) }
      let params = value.object([("name", value.string(toolkit.str_arg(a, "tool"))), ("arguments", arguments)])
      match mcp.ask(s.scratch, s.root, sv, "tools/call", params) {
        err(e) => toolkit.failed(e, toolkit.first_line_of(e, 80)),
        ok(result) => {
          let (text, bad) = mcp.call_result(result)
          if bad then toolkit.failed(toolkit.capped(s, text)!, "the tool reported an error · " + toolkit.count_lines(text))
          else toolkit.said(toolkit.capped(s, text)!, toolkit.count_lines(text))
        },
      }
    },
  }

// A note for later sessions, added to the project's file (memory.almd). It asks no
// permission: the file is comide's own, outside the project.
effect fn remember(s: toolkit.Setup, a: Value) -> toolkit.ToolResult =
  if s.memory_file == "" then toolkit.failed("Nothing is kept in this session: it has no place for notes.", "not kept")
  else match memory.keep(s.memory_file, toolkit.str_arg(a, "note")) {
    err(e) => toolkit.failed("Not kept: " + e, "not kept"),
    ok(line) => toolkit.said("Kept in " + s.memory_file + ":\n" + line, "kept"),
  }

// A skill's text, read now that it is wanted. Nothing is run: a skill is words.
effect fn skill(s: toolkit.Setup, a: Value) -> toolkit.ToolResult = {
  let name = toolkit.str_arg(a, "name")
  match list.find(s.skills, (row) => row.0 == name) {
    none => toolkit.failed("There is no skill called " + name + ". The skills are: " + (if list.is_empty(s.skills) then "(none)" else list.join(list.map(s.skills, (row) => row.0), ", ")), "no such skill"),
    some(row) => match fs.read_text(row.1) {
      err(e) => toolkit.failed("The skill " + name + " could not be read: " + e, "could not be read"),
      ok(text) => toolkit.said(toolkit.capped(s, skills.opened(row.1, text))!, toolkit.count_lines(skills.body(text))),
    },
  }
}

// The tools that change something, run something, or reach outside.
effect fn changed(s: toolkit.Setup, name: String, a: Value) -> toolkit.ToolResult =
  if name == "edit" then solving.edit(s, a)!
  else if name == "write" then solving.write(s, a)!
  else if name == "shell" then shell(s, a)!
  else if name == "solve" then solving.solve(s, a)!
  else if name == "web_search" then web.web_search(s, a)!
  else if name == "web_fetch" then web.web_fetch(s, a)!
  else if name == "mcp_call" then mcp_call(s, a)!
  else toolkit.failed("there is no tool called " + name, "no such tool")

// What the model is told about the project before the first request: its layout and
// its git state, both cheap, neither needing permission. Measured on the first
// conversation without it: asked to run the tests of a Python project, the model's
// first command was `npm test`.
effect fn project_context(s: toolkit.Setup) -> String = {
  let (_, tree) = toolkit.run_in(s, "read", "hew", ["tree", s.root, "--depth", "2"], 30)!
  let (git_code, git) = toolkit.run_in(s, "read", "bash", ["-c", "cd " + toolkit.shell_quote(s.root) + " && git branch --show-current && git status --short | head -20"], 30)!
  let tree_part = string.take(toolkit.relative(s, tree), 3000)
  let git_part = if git_code == 0 then "\n\ngit branch and uncommitted changes:\n" + git else "\n\nnot a git repository"
  "Project layout:\n" + tree_part + git_part
}

// The call as the person sees it, `read(shop/cart.py:40-90)`: the argument that says
// what the call is about, not all of them.
fn call_label(name: String, arguments: String) -> String =
  match json.parse(arguments) {
    err(_) => "",
    ok(a) => {
      let label = label_of(name, a)
      if string.len(label) > 100 then string.take(label, 100) + "…" else label
    },
  }

// The tools one argument of which says what the call is about.
let LABEL_ARGS = [("explore", "task"), ("skill", "name"),("remember", "note"),("map", "task"),("shell", "command"), ("web_search", "query"), ("web_fetch", "url")]

fn label_of(name: String, a: Value) -> String = {
  let arg = (k: String) => toolkit.str_arg(a, k)
  let path = if arg("path") == "" then "." else arg("path")
  if name == "read" then path + narrowed(a)
  else if name == "search" then "/" + arg("pattern") + "/" + (if arg("path") == "" then "" else " in " + arg("path"))
  else if name == "solve" then arg("task") + " · verify: " + arg("verify")
  else if name == "mcp_call" or name == "mcp_describe" then arg("server") + "/" + arg("tool")
  else if name == "mcp_tools" then arg("server")
  else match list.find(LABEL_ARGS, (row) => row.0 == name) {
    some(row) => arg(row.1),
    none => path,
  }
}

// How a read is narrowed: ` symbol`, `:lines`, or ` /grep/`.
fn narrowed(a: Value) -> String = {
  let arg = (k: String) => toolkit.str_arg(a, k)
  if arg("symbol") != "" then " " + arg("symbol")
  else if arg("lines") != "" then ":" + arg("lines")
  else if arg("grep") != "" then " /" + arg("grep") + "/"
  else ""
}

// The part of a call that decides whether the person is asked first: a shell command,
// or the verify command golemide will run, which is a shell command too.
fn command_of(name: String, arguments: String) -> String? =
  match json.parse(arguments) {
    ok(a) => if name == "shell" then some(toolkit.str_arg(a, "command"))
      else if name == "solve" then some(toolkit.str_arg(a, "verify"))
      // A call into another program can do whatever that program does.
      else if name == "mcp_call" then some(toolkit.str_arg(a, "server") + "/" + toolkit.str_arg(a, "tool"))
      else none,
    err(_) => none,
  }

// The tools that change the project, run a command, or write something down: the ones a
// session that only looks does not run.
fn changes(name: String) -> Bool = list.contains(["edit", "write", "shell", "solve", "remember", "mcp_call"], name)

fn frozen_reason(frozen: String) -> String =
  if frozen == "plan" then "Not run: this session is in plan mode. Look at the project and write the plan: what you would change, in which files, in what order, and how each step would be checked. Nothing is changed and no command is run until the user approves the plan."
  else "Not run: this session only looks. It cannot change a file or run a command; answer from what you can read."

// What a call is about as the settings' rules see it (rules.almd): the tool the rule
// names, and the command, path, address or words. solve's verify command is a shell
// command and answers to the shell rules; a page is known by its host.
fn subject_of(name: String, arguments: String, root: String) -> (String, String) =
  match json.parse(if string.trim(arguments) == "" then "{}" else arguments) {
    err(_) => (name, ""),
    ok(a) => {
      let arg = (k: String) => toolkit.str_arg(a, k)
      if name == "shell" then ("shell", arg("command"))
      else if name == "solve" then ("shell", arg("verify"))
      else if name == "web_fetch" then ("web_fetch", "domain:" + host_of(arg("url")))
      else if name == "web_search" then (name, arg("query"))
      else if name == "skill" then (name, arg("name"))
      else if name == "remember" then (name, arg("note"))
      else if name == "map" or name == "explore" then (name, arg("task"))
      else if name == "mcp_call" or name == "mcp_describe" then (name, arg("server") + "/" + arg("tool"))
      else if name == "mcp_tools" then (name, arg("server"))
      // A path written from the root of the disk is the same file as the one written
      // from the project, and the rules are written from the project.
      else (name, if arg("path") == "" or arg("path") == root then "." else (string.strip_prefix(arg("path"), root + "/") ?? arg("path")))
    },
  }

fn host_of(url: String) -> String = {
  let rest = match string.split_once(url, "://") { some((_, r)) => r, none => url }
  let upto = (s: String, mark: String) => match string.split_once(s, mark) { some((before, _)) => before, none => s }
  string.to_lower(upto(upto(upto(rest, "/"), "?"), ":"))
}

test "a session that only looks keeps the tools that read and holds the ones that change" {
  assert(list.all(["edit", "write", "shell", "solve", "remember"], changes))
  assert(not list.any(["read", "outline", "search", "tree", "map", "skill", "web_search", "web_fetch"], changes))
  assert(string.contains(frozen_reason("plan"), "plan mode"))
  assert(string.contains(frozen_reason("look"), "only looks"))
}

test "the rules see a call by its command, its path or its host" {
  assert_eq(subject_of("shell", "{\"command\":\"git status\"}", "/w/p"), ("shell", "git status"))
  assert_eq(subject_of("solve", "{\"task\":\"t\",\"verify\":\"cargo test\"}", "/w/p"), ("shell", "cargo test"))
  assert_eq(subject_of("edit", "{\"path\":\"src/a.py\",\"old\":\"x\",\"new\":\"y\"}", "/w/p"), ("edit", "src/a.py"))
  assert_eq(subject_of("read", "{\"path\":\"/w/p/.env\"}", "/w/p"), ("read", ".env"))
  assert_eq(subject_of("read", "{\"path\":\"/etc/passwd\"}", "/w/p"), ("read", "/etc/passwd"))
  assert_eq(subject_of("tree", "{}", "/w/p"), ("tree", "."))
  assert_eq(subject_of("web_fetch", "{\"url\":\"https://Docs.Example.com:8443/a?b=c\"}", "/w/p"), ("web_fetch", "domain:docs.example.com"))
}

test "a call is shown by what it is about" {
  assert_eq(call_label("read", "{\"path\":\"a.py\",\"lines\":\"3-9\"}"), "a.py:3-9")
  assert_eq(call_label("shell", "{\"command\":\"go test ./...\"}"), "go test ./...")
  assert_eq(call_label("tree", "{}"), ".")
  assert_eq(toolkit.count_lines("a\nb\n"), "2 lines")
  assert_eq(toolkit.count_lines(""), "0 lines")
}

test "only a shell command or a verify command asks first" {
  assert_eq(command_of("shell", "{\"command\":\"rm -rf build\"}"), some("rm -rf build"))
  assert_eq(command_of("solve", "{\"task\":\"t\",\"verify\":\"pytest\"}"), some("pytest"))
  assert_eq(command_of("read", "{\"path\":\"a\"}"), none)
  assert_eq(command_of("web_fetch", "{\"url\":\"https://example.com\"}"), none)
  assert_eq(command_of("web_search", "{\"query\":\"almide\"}"), none)
}
