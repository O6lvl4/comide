// One request of the conversation, worked to an answer with the model asked in writing.
//
// The core is the errand's (errand.almd, measured against terminus-2): no tool is sent,
// every reply is one JSON object (analysis, plan, commands, task_complete), and the model
// has one terminal that lasts from command to command and from request to request. What
// the conversation adds to it is everything comide could do before this loop:
//
//   - comide's tools (tools.almd): a command object may be {"tool": NAME, "args": {...}}
//     in place of a terminal command. edit, write and solve go through golemide as they
//     always did; read, outline, search, tree, map, web, skill, explore, MCP and remember
//     are the same code, with the same permissions and hooks (turn.run_call).
//   - the person: a command no rule speaks of is put to them, a declined one is said back
//     with their words, Esc stops the model mid-answer.
//   - plan mode and --read-only: the tools that change things and the terminal are held.
//   - the check after a change (watch.almd), a goal (goal.almd), the Stop hook, the note
//     that takes a long conversation's place (handover.almd), and the look for a model
//     going round in circles.
//
// The loop that sends tools (turn.almd) is still there, as --loop tools.

import env
import fs
import io
import json
import self.asking
import self.charge
import self.convo
import self.exchange
import self.goal
import self.handover
import self.hooks
import self.model
import self.options
import self.rules
import self.said
import self.shell
import self.talk
import self.toolkit
import self.tools
import self.turn
import self.ui
import process
import self.waiting
import self.watch

let MAX_TOKENS = 65536
let UNREAD_ROUNDS = 5
let CALL_MAX_MS = 930000
let STOP_ROUNDS = 5

// One tool, as a line the model reads: its name, what it does, and its arguments. The
// terminal is not among them: it is what a plain command object is.
fn tool_line(t: Value) -> String = {
  let f = value.get(t, "function") ?? value.object([])
  let params = value.get(f, "parameters") ?? value.object([])
  let required = list.map(value.get_array(params, "required") ?? [], (r) => value.as_string(r) ?? "")
  let props = value.as_object(value.get(params, "properties") ?? value.object([])) ?? []
  "- " + (value.get_string(f, "name") ?? "") + ": " + (value.get_string(f, "description") ?? "") + "\n"
    + list.join(list.map(props, (p) => "    " + p.0 + " (" + (value.get_string(p.1, "type") ?? "string")
      + (if list.contains(required, p.0) then "" else ", optional") + "): " + (value.get_string(p.1, "description") ?? "")), "\n")
}

fn name_of(t: Value) -> String = value.get_string(value.get(t, "function") ?? value.object([]), "name") ?? ""

// `without`: tools that cannot work here (a search with no engine to ask), left unsaid so
// that no step is spent finding it out.
fn tools_section(without: List[String]) -> String =
  list.join(list.map(list.filter(tools.definitions(), (t) => name_of(t) != "shell" and not list.contains(without, name_of(t))), tool_line), "\n")

// Languages the model is unlikely to know well: the program whose presence says the
// language is in use on this machine, and how its own toolchain tells about it. The first
// person to ask 0.7.0 for Almide watched it go looking through the project for what
// Almide might be.
//
// The second person-run (2026-11-21) had the toolchain's commands and still took fifteen
// steps to FizzBuzz: the commands list functions, not syntax, so the model read five files
// of a neighbouring project to learn `if` and `for`. The syntax a first program needs is
// said here. The program below is ci-checked text: `almide check`, `run` and `test` pass
// on it (0.70.0).
let ALMIDE_NOTE = "Almide (.almd files) is a language you may not know well, and its toolchain is installed here. Do not guess, and do not read through the project to learn the language. Its syntax, in one program:\n\n"
  + "import fs                                  // json, fs, http, env, io, process, regex need an import; string, list, int, map, value do not\n\n"
  + "type Shape =\n  | Circle(Float)\n  | Rect(Float, Float)\n\n"
  + "type Point = { x: Int, y: Int }\n\n"
  + "fn area(s: Shape) -> Float = match s {\n  Circle(r) => 3.14 * r * r,\n  Rect(w, h) => w * h,\n}\n\n"
  + "fn label(n: Int) -> String =\n  if n % 15 == 0 then \"FizzBuzz\" else if n % 3 == 0 then \"Fizz\" else if n % 5 == 0 then \"Buzz\" else int.to_string(n)\n\n"
  + "effect fn main() -> Unit = {                // `effect fn`: may do I/O or fail. A pure function is `fn`\n"
  + "  let p = Point { x: 1, y: 2 }              // let is fixed, var can be assigned again\n"
  + "  var total = 0\n"
  + "  for i in 1...10 {                         // 1...10 includes 10; 0..<10 does not. Also: while cond { }\n"
  + "    total = total + i\n    println(label(i))\n  }\n"
  + "  let names = list.map([1, 2, 3], (n) => \"n$" + "{n}\")   // a lambda; $" + "{...} inside a string interpolates\n"
  + "  let first = list.get(names, 0) ?? \"none\"   // ?? gives a fallback for an Option or a Result\n"
  + "  let text = fs.read_text(\"notes.txt\")!       // ! passes a failure up; it is required on a call that can fail\n"
  + "  println(\"$" + "{first} $" + "{total} $" + "{p.x + p.y} $" + "{area(Circle(1.0))} $" + "{string.len(text)}\")\n}\n\n"
  + "test \"label\" {\n  assert_eq(label(15), \"FizzBuzz\")\n}\n\n"
  + "`if` always has `then` and `else`; there is no `return`: a function's value is its last expression. "
  + "For the standard library: `almide query stdlib` prints the common modules' functions with their signatures, and `almide query outline @stdlib/MODULE` (string, list, int, map, fs, json, ...) one module's; both work in any directory. "
  + "`almide check FILE` type-checks a file, `almide run FILE` runs it, `almide test FILE` runs its tests, and `almide explain E041` explains an error code. "
  + "Check what you wrote with `almide check` before saying it works. To try a snippet that is not part of the project, write it under a temporary directory (mktemp -d), not into the project: inside a project `almide run` builds the whole project."

let TOOLCHAINS: List[(String, String)] = [("almide", ALMIDE_NOTE)]

// Asked for FizzBuzz, and finding the compiler's toolchain too old to run it, the model
// tried `rustup update` on the person's machine, with "stop asking" already given.
let OWN_MACHINE = "\n\nThis is the user's own machine. Do not install, update or remove toolchains, system packages or global tools, and do not change settings outside the project, unless the user asked for that: say what is missing and what would fix it, and let the user decide."

// What is said of the toolchains found on PATH, or "" when none is.
effect fn toolchains() -> String =
  list.join(list.filter_map(TOOLCHAINS, (t) => match process.output(process.ProcessCommand { cmd: "bash", args: ["-c", "command -v " + t.0] }) {
    ok(st) => if st.code == 0 then some(t.1) else none,
    err(_) => none,
  }), "\n\n")

// What the model is told: the errand's words unchanged (charge.written_prompt), then who
// it is working with and the tools. Nothing here asks it to be brief.
// `someone`: a person is at the terminal, and the machine is theirs (a conversation). With
// nobody there (-p in a container, a measured run) the machine is the task's to change.
fn system_prompt(root: String, without: List[String], someone: Bool) -> String = string.trim(charge.written_prompt(root)) + (if someone then OWN_MACHINE else "") + """


You are comide, a coding assistant, working with a user in the project at ${root}. The terminal starts there. What the user asks may be a task or a question; when you set "task_complete", your "analysis" is what the user reads as your answer: say what you changed and how you know it works, or answer the question, in the language the user wrote in. If nothing checked the work, say so. A question that needs no command is answered at once, with "commands" empty and "task_complete" true.

A command of yours may be put to the user before it runs, and the user may decline it. The user sees each command and the first lines of what it printed, not all of it: when the user asked for a result, put the result itself in your answer, not a report that it was printed. The same for code or text the user asks to see: it goes inside "analysis", whole, in a fenced block. Nothing but "analysis" reaches the user, so "here it is" with nothing after it shows them nothing.

The terminal keeps its directory from one command to the next: after `cd sub`, the next command starts in sub. Use paths from where the terminal is, and do not leave files of your own behind in the user's project unless they are what was asked for.

Besides the terminal you have comide's tools. A command object may also be:
- {"tool": "NAME", "args": {...}}: run one of the tools below, with its arguments. It is run by comide, not in the terminal, in the order you wrote it, and its result is shown to you like a command's output.

A text of more than a few lines (a file's contents, a script) is not written inside the JSON. Write "@body:NAME" where it is meant, as a tool argument or as a "command", and after the closing brace of the object write the text as it is, with nothing escaped, between a line `<<<BODY NAME` and a line `>>>BODY NAME`:

{"analysis": "...", "plan": "...", "commands": [{"tool": "write", "args": {"path": "hello.py", "content": "@body:hello"}}, {"command": "python3 hello.py\n", "wait_s": 5}], "task_complete": false}
<<<BODY hello
print("as it is, quotes and all")
>>>BODY hello

How the tools and the terminal divide the work:
- To change a file, use edit, copying old exactly from what read showed, without the line numbers; use write for a new file or a complete rewrite. Every write is syntax-checked first: if one is refused, read the reason, look again, and retry. Do not write files with cat, sed or echo in the terminal when edit or write can do it.
- solve is for one case only: code that is already there, and a command that already exists and tells whether the change is right (the project's test suite, its build). It hands the change to golemide, which reads the code, edits it, runs the command and retries, and it can take minutes. The command must exist as written, run all the tests, and fail when a test fails. When solve reports the command passing, the work is done: do not run it again. Do not use solve to create files, in an empty directory, or with a check you have yet to write: there it fails or runs out of time. Write the file yourself.
- To look at code, read, outline, search, tree and map are narrower than cat and grep and never need the user's leave. In a project you have not seen, start with map or tree.
- Run tests, builds and everything else in the terminal.

The tools:
""" + tools_section(without)

// The first request is the task; what the person says after it is said as they said it.
fn request(messages: List[Value], text: String) -> String =
  if list.any(messages, (m) => (value.get_string(m, "role") ?? "") == "user") then text else "Task Description:\n" + text

// The conversation's terminal: its state is in the session's scratch directory, so it is
// the same one from request to request.
effect fn terminal(setup: toolkit.Setup) -> shell.Shell = {
  let dir = setup.scratch + "/terminal"
  let _ = fs.mkdir_p(dir)
  shell.at(dir, setup.root)!
}

// Ends what the conversation's terminal left running. Called when the conversation ends.
effect fn close(setup: toolkit.Setup) -> Unit =
  if fs.exists(setup.scratch + "/terminal/cwd") then shell.close(terminal(setup)!)! else ()

// One model call, watched: a spinner, and Esc to stop it. The reply is JSON and is not
// shown as it arrives. `none` is the person stopping it.
effect fn heard(opts: options.Options, scratch: String, n: Int, messages: List[Value], tries: Int) -> Result[exchange.Reply?, String] = {
  let fake = string.trim(env.get("COMIDE_FAKE") ?? "")
  if fake != "" then ok(some(talk.ask(n, opts.model, messages, [], MAX_TOKENS)!))
  else {
    let once: Result[exchange.Reply?, String] = match model.start(opts.model, messages, [], MAX_TOKENS, "", scratch) {
      err(e) => err(e),
      ok(c) => {
        let t0 = datetime.now_ms()
        var frame = 0
        var interrupted = false
        while not model.is_done(c)! and datetime.now_ms() - t0 <= CALL_MAX_MS and not interrupted {
          interrupted = waiting.pause(opts)!
          if opts.live and opts.ui.color then io.print(ui.waiting(opts.ui, frame / 3, (datetime.now_ms() - t0) / 1000, "Working", if opts.tui then "esc to interrupt" else ""))
          frame = frame + 1
        }
        if opts.live and opts.ui.color then io.print(ui.clear_line(opts.ui))
        if interrupted then { model.abandon(c)!; ok(none) }
        else if not model.is_done(c)! then { model.abandon(c)!; err("request timeout: no complete answer within 930s") }
        else match model.settle(c) {
          err(e) => err(e),
          ok(r) => ok(some(exchange.Reply { content: r.content, reasoning: r.reasoning, calls: [], finish: r.finish,
            usd: r.cost_usd, input: r.input_tokens, cached: r.cached_tokens, output: r.output_tokens })),
        }
      },
    }
    match once {
      ok(r) => ok(r),
      err(e) => if tries + 1 < convo.MODEL_TRIES and convo.retryable(e) then {
        let wait = convo.retry_wait_ms(tries) + datetime.now_ms() % 1000
        options.show(opts, ui.note_line(opts.ui, string.take(e, 120) + "; trying again in " + int.to_string(wait / 1000) + "s"))!
        env.sleep_ms(wait)
        heard(opts, scratch, n, messages, tries + 1)
      } else err(e),
    }
  }
}

// Whether a terminal command may run, and what the model reads if it may not. In a
// session that only looks, the terminal is held like every tool that changes things;
// then the hooks, the rules, and the person, as for a shell call in the other loop.
effect fn permitted(opts: options.Options, setup: toolkit.Setup, allow: Bool, command: String) -> (asking.Permission, String) = {
  let held = asking.Permission { run: false, allow_from_now: allow, said: "" }
  if setup.frozen != "" then (held, "[" + tools.frozen_reason(setup.frozen) + " To look at the project, use the tools that read: read, outline, search, tree, map.]")
  else {
    let pre = turn.hooked(opts, setup, "PreToolUse", "shell", value.object([("command", value.string(command))]), "", "")!
    if pre.stopped then (held, "[not run: a check the user set up stopped this command:\n" + pre.reason + "]")
    else match rules.decide(setup.allow_rules, setup.ask_rules, setup.deny_rules, "shell", command) {
      Denied(rule) => (held, "[not run: the settings deny this command (" + rule + "). Do not look for another way to do the same thing; go on without it, or say in your analysis what you need.]"),
      Asked(rule) => if not opts.live then (held, "[not run: the settings say to ask a person before this command (" + rule + "), and nobody is here to ask.]")
        else {
          let a = asking.permitted(opts, false, "The settings ask before this (" + rule + "). Run it?")!
          (asking.Permission { run: a.run, allow_from_now: allow, said: a.said }, "")
        },
      Allowed(_) => (asking.Permission { run: true, allow_from_now: allow, said: "" }, ""),
      Unsaid => (asking.permitted(opts, allow, "Run this command?")!, ""),
    }
  }
}

fn declined(said_by_person: String) -> String =
  if said_by_person == "" then "[not run: the user declined this command. Do not try it again in another form; go on without it, or say in your analysis what you need.]"
  else "[not run: the user declined this command and said: " + said_by_person + "]"

// Whether a command's output says it failed: its last line is its exit code.
fn command_failed(text: String) -> Bool = {
  let last = string.trim(list.last(string.split(string.trim(text), "\n")) ?? "")
  string.starts_with(last, "[exit code ") and last != "[exit code 0]"
}

// The lines of a command after its first, as the person sees them under the call line.
let COMMAND_LINES = 14

fn command_rest(u: ui.Ui, command: String) -> String = {
  let rest = list.drop(string.split(string.trim(command), "\n"), 1)
  let first = list.take(rest, COMMAND_LINES)
  let more = list.len(rest) - list.len(first)
  let lines = list.map(first, (l) => "    " + string.take(l, int.max(20, u.width - 6)))
  list.join(if more > 0 then lines + ["    " + ui.dim(u, "… " + int.to_string(more) + " more lines")] else lines, "\n")
}

// What a command printed, as the person sees it: its first lines, and how many more there
// were. The last line (the exit code, or that it is still running) is the result line's.
// Without this the person saw `[exit code 0]` and nothing of what they had asked to see.
let OUTPUT_LINES = 10

fn output_shown(u: ui.Ui, text: String) -> String = {
  let all = string.split(string.trim(text), "\n")
  let body = list.take(all, int.max(0, list.len(all) - 1))
  let first = list.take(body, OUTPUT_LINES)
  let more = list.len(body) - list.len(first)
  let lines = list.map(first, (l) => "    " + ui.dim(u, string.take(l, int.max(20, u.width - 6))))
  list.join(if more > 0 then lines + ["    " + ui.dim(u, "… " + int.to_string(more) + " more lines")] else lines, "\n")
}

// One call of the terminal, with the wait shown: a line rewritten in place that says the
// command is running, for how long, and the last thing it printed. Esc stops the command.
// Where nothing is drawn (a run with nobody there) it is shell.call.
effect fn watched_call(opts: options.Options, sh: shell.Shell, a: Value) -> (shell.Shell, String) = {
  let command = value.get_string(a, "command") ?? ""
  let job = shell.int_arg(a, "job")
  let starting = string.trim(command) != ""
  let waiting_for = not starting and job > 0 and job < sh.next and not (value.get_bool(a, "stop") ?? false)
  if not (opts.live and opts.ui.color) or not (starting or waiting_for) then shell.call(sh, a)!
  else {
    let begun: Result[shell.Shell, String] = if starting then shell.start(sh, command) else ok(sh)
    match begun {
    err(e) => (sh, "[the command could not be started: " + e + "]"),
    ok(now) => {
      let n = if starting then sh.next else job
      let wait_s = shell.clamp_wait(shell.int_arg(a, "wait_s"))
      let t0 = datetime.now_ms()
      var frame = 0
      var last = ""
      var interrupted = false
      while not shell.finished(now, n)! and datetime.now_ms() - t0 < wait_s * 1000 and not interrupted {
        interrupted = waiting.pause(opts)!
        if frame % 5 == 0 then { last = shell.last_line(now, n)! }
        let room = int.max(10, opts.ui.width - 40)
        io.print(ui.waiting(opts.ui, frame / 3, (datetime.now_ms() - t0) / 1000, "Running",
          list.join(list.filter([if opts.tui then "esc to stop" else "", string.take(last, room)], (p) => p != ""), " · ")))
        frame = frame + 1
      }
      io.print(ui.clear_line(opts.ui))
      if interrupted then (now, shell.stop(now, n)! + "\n[The user stopped this command.]")
      else (now, shell.report(now, n, wait_s)!)
    },
    }
  }
}

// What the orders of one reply came to.
type Ran ={ sh: shell.Shell, allow: Bool, seen: String, spent: Float, work: watch.Work, sigs: List[String] }

// The orders of one reply, in order. A command the person or the settings stop is not
// run, and the orders after it in the same reply are not run either: they were written
// expecting it to have run. A tool is one of comide's (turn.run_call), with its own
// permissions and hooks, and a refusal there does not stop what follows.
effect fn run_orders(opts: options.Options, setup: toolkit.Setup, sh0: shell.Shell, allow0: Bool, work0: watch.Work, orders: List[said.Order]) -> Ran = {
  var sh = sh0
  var allow = allow0
  var work = work0
  var spent = 0.0
  var parts: List[String] = []
  var sigs: List[String] = []
  var stopped = false
  for o in orders {
    if stopped then list.push(parts, said.shown(o) + "\n[not run: an earlier command of this reply was not run]")
    else if o.tool != "" and string.trim(o.command) == "" then {
      list.push(sigs, watch.signature(o.tool, o.args))
      if o.tool == "shell" then list.push(parts, said.shown(o) + "\n[there is no tool named shell here: a terminal command is {\"command\": \"...\"}]")
      else {
        let ran = turn.run_call(opts, setup, model.ToolCall { id: "", name: o.tool, arguments: o.args }, turn.Ran { results: [], allow: allow, spent: 0.0, work: work })!
        allow = ran.allow
        work = ran.work
        spent = spent + ran.spent
        list.push(parts, said.shown(o) + "\n" + (value.get_string(list.last(ran.results) ?? value.object([]), "content") ?? ""))
      }
    } else {
      let command = string.trim(o.command)
      options.show(opts, "\n" + ui.call_line(opts.ui, "shell", if command == "" then string.trim(said.shown(o)) else charge.first_line(command, int.max(20, opts.ui.width - 12))))!
      // The rest of a command of several lines (a file written through a here-document):
      // with the first line alone, a person approved, and then asked to see, code that
      // had never been on the screen.
      let rest = command_rest(opts.ui, command)
      if rest != "" then options.show(opts, rest)! else ()
      let before = shell.text_of(sh.dir + "/cwd")!
      let (p, refused) = if command == "" then (asking.Permission { run: true, allow_from_now: allow, said: "" }, "") else permitted(opts, setup, allow, o.command)!
      allow = p.allow_from_now
      if not p.run then {
        let why = if refused != "" then refused else declined(p.said)
        options.show(opts, ui.result_line(opts.ui, "not run", true))!
        list.push(parts, said.shown(o) + "\n" + why)
        stopped = true
      } else {
        let (next_sh, ran_text) = watched_call(opts, sh, said.arguments(o))!
        // A command that left the terminal somewhere else says so to the model: three
        // commands in a row were written for a directory the terminal had left.
        let now_in = string.trim(shell.text_of(next_sh.dir + "/cwd")!)
        let text = if now_in != "" and now_in != string.trim(before) then ran_text + "\n[the terminal is now in " + now_in + "]" else ran_text
        sh = next_sh
        shell.keep(sh)!
        let post = if command == "" then hooks.quiet() else turn.hooked(opts, setup, "PostToolUse", "shell", value.object([("command", value.string(o.command))]), string.take(text, 20000), "")!
        let bad = command_failed(text)
        let printed = output_shown(opts.ui, text)
        if printed != "" then options.show(opts, printed)! else ()
        options.show(opts, ui.result_line(opts.ui, charge.first_line(list.last(string.split(string.trim(text), "\n")) ?? "", int.max(20, opts.ui.width - 6))
          + (if post.stopped then " · a hook objects" else ""), bad or post.stopped))!
        list.push(parts, said.shown(o) + "\n" + text + (if post.stopped then "\n\n[A check the user set up objects to this:]\n" + post.reason else ""))
        if command != "" then {
          let as_call = json.stringify(value.object([("command", value.string(o.command))]))
          work = watch.after(work, "shell", as_call, bad)
          list.push(sigs, watch.signature("shell", as_call))
        }
      }
    }
  }
  Ran { sh: sh, allow: allow, seen: if list.is_empty(parts) then charge.NOTHING_NOTE else list.join(parts, "\n\n"), spent: spent, work: work, sigs: sigs }
}

effect fn answer(opts: options.Options, text: String) -> Unit = {
  let said_text = if string.trim(text) == "" then "(done)" else string.trim(text)
  if opts.live then println("\n" + convo.answer_lines(opts.ui, said_text, true)) else println(said_text)
}

effect fn turn(opts: options.Options, setup0: toolkit.Setup, s: options.Session, user: String) -> options.Session = {
  // Plan mode is the session's, and can be switched while it runs; --read-only is the run's.
  let setup = if s.plan then { ...setup0, frozen: "plan" } else if opts.read_only then { ...setup0, frozen: "look" } else setup0
  let before = turn.hooked(opts, setup, "UserPromptSubmit", "", value.null(), "", user)!
  if before.stopped then {
    options.show(opts, "\n" + ui.result_line(opts.ui, "not sent: a hook stopped this request: " + before.reason, true))!
    s
  } else {
    let u = opts.ui
    var messages = s.messages + [exchange.message("user", request(s.messages, user)
      + (if before.printed == "" then "" else "\n\n[Added by a hook]\n" + before.printed)
      + (if s.plan then "\n\n" + turn.PLAN_NOTE else ""))]
    var sh = terminal(setup)!
    var allow = s.allow_shell
    var cost = 0.0
    var steps = 0
    var tin = 0
    var tcached = 0
    var tout = 0
    var last_in = s.last_in
    var unread = 0
    var asked = false
    var acted = false
    var done = false
    var work = watch.fresh(s.check)
    var check_rounds = 0
    var sigs: List[String] = []
    var loop_warned = false
    var stop_rounds = 0
    // A goal is not pressed in a session that cannot act on it.
    let aim = if setup.frozen == "" then s.goal else ""
    var aim_rounds = 0
    var aim_asked = false
    var aim_met = false
    let too_long = handover.limit()!
    while not done {
      // The conversation has outgrown the model: a note takes its place (handover.almd).
      if last_in > too_long and list.len(messages) > 4 then {
        match handover.written(opts.model, opts.effort, setup.scratch, messages, user, aim) {
          err(e) => {
            options.show(opts, "\n" + ui.note_line(u, "the conversation is long, and a note could not be written in its place: " + string.take(e, 200)))!
            last_in = 0
          },
          ok(n) => {
            options.show(opts, "\n" + ui.note_line(u, "the conversation was long; a note now stands in its place (" + int.to_string(n.before / 1000) + "k → "
              + int.to_string(n.after / 1000) + "k characters, " + convo.usd(n.cost_usd) + "); what it replaced is in " + n.kept_at))!
            messages = n.messages
            cost = cost + n.cost_usd
            last_in = 0
            aim_asked = false
          },
        }
      }
      if steps >= opts.max_steps then {
        options.show(opts, "\n" + ui.note_line(u, "stopped after " + int.to_string(steps) + " steps without a final answer; say how to continue"))!
        done = true
      } else match heard(opts, setup.scratch, s.steps + steps + 1, messages, 0) {
        err(e) => {
          options.show(opts, "\n" + ui.result_line(u, "the model could not be reached: " + string.take(e, 300), true))!
          done = true
        },
        ok(none) => {
          options.show(opts, ui.result_line(u, "Interrupted · what should comide do instead?", true))!
          done = true
        },
        ok(some(r)) => {
          steps = steps + 1
          cost = cost + r.usd
          tin = tin + r.input
          tcached = tcached + r.cached
          tout = tout + r.output
          last_in = r.input
          list.push(messages, exchange.assistant_message(r, []))
          turn.record_cost(s.cost + cost)!
          match said.read_reply(r.content, true, r.finish != "length") {
            err(reason) => {
              unread = unread + 1
              options.show(opts, "\n" + ui.note_line(u, "the reply could not be read (" + reason + "); nothing was run"))!
              if unread >= UNREAD_ROUNDS then {
                options.show(opts, "\n" + ui.result_line(u, int.to_string(unread) + " replies in a row could not be read; say how to continue", true))!
                done = true
              } else list.push(messages, exchange.message("user", if r.finish == "length" then charge.WRITTEN_CUT_NOTE else charge.unread_note(reason)))
            },
            ok(w) => {
              unread = 0
              let had_orders = not list.is_empty(w.orders)
              // The analysis of a step that goes on is shown as a note; the last one is the answer.
              if string.trim(w.analysis) != "" and (had_orders or not w.complete) then options.show(opts, "\n" + ui.note_line(u, charge.first_line(w.analysis, 300)))!
              let ran = run_orders(opts, setup, sh, allow, work, w.orders)!
              sh = ran.sh
              allow = ran.allow
              work = ran.work
              cost = cost + ran.spent
              sigs = sigs + ran.sigs
              if had_orders then { acted = true; aim_asked = false }
              // Complete is asked about once, as in an errand, when work was done in this
              // request. An answer to a question is not asked about: it is the answer.
              let next = if w.complete and not acted then said.Done else said.after(w, asked)
              match next {
                Work => {
                  if not had_orders and not w.complete then {
                    // Words with nothing to run and not said to be the end: taken as the answer,
                    // so a model that forgets the flag does not go round until the step limit.
                    answer(opts, w.analysis)!
                    done = true
                  } else if watch.repeating(sigs) then {
                    if loop_warned then {
                      options.show(opts, "\n" + ui.note_line(u, "stopped: the same calls kept coming back; say how to continue"))!
                      list.push(messages, exchange.message("user", ran.seen))
                      done = true
                    } else {
                      options.show(opts, "\n" + ui.note_line(u, "the same calls three times over; comide asks the model to step back"))!
                      list.push(messages, exchange.message("user", ran.seen + "\n\n" + watch.LOOP_NOTE))
                      loop_warned = true
                      sigs = []
                    }
                  } else list.push(messages, exchange.message("user", ran.seen))
                  asked = false
                },
                AskSure => {
                  list.push(messages, exchange.message("user", ran.seen + "\n\n" + charge.WRITTEN_CONFIRM_NOTE))
                  asked = true
                },
                Done => {
                  // Said to be the end. What may still say it is not: the check after a
                  // change, a goal that stands, and a Stop hook, in that order.
                  var go_on = ""
                  match watch.at_finish(work, check_rounds) {
                    Done => (),
                    RunCheck(command) => {
                      let (out, bad, did_run, allow_now) = turn.run_check(opts, setup, command, allow)!
                      allow = allow_now
                      check_rounds = check_rounds + 1
                      if did_run then { work = watch.checked(work, command, bad) }
                      if did_run and bad then { go_on = watch.check_failed_note(command, out) }
                    },
                    Remind(command) => {
                      options.show(opts, "\n" + ui.note_line(u, "the last run of " + command + " failed; comide asks the model to go on"))!
                      check_rounds = check_rounds + 1
                      go_on = watch.still_failing_note(command)
                    },
                  }
                  if go_on == "" and aim != "" then {
                    match goal.after_answer(aim, w.analysis, aim_asked, aim_rounds) {
                      Ask => {
                        options.show(opts, "\n" + ui.note_line(u, "a goal stands; comide asks whether it is met"))!
                        aim_asked = true
                        aim_rounds = aim_rounds + 1
                        go_on = goal.asked(aim)
                      },
                      Met => {
                        options.show(opts, "\n" + ui.note_line(u, "the goal is met, by the model's account, and is cleared"))!
                        aim_met = true
                      },
                      NeedsPerson => (),
                      Enough => options.show(opts, "\n" + ui.note_line(u, "asked " + int.to_string(aim_rounds) + " times whether the goal is met; say how to continue"))!,
                    }
                  }
                  if go_on == "" and stop_rounds < STOP_ROUNDS then {
                    let at_stop = turn.hooked(opts, setup, "Stop", "", value.null(), "", "")!
                    if at_stop.stopped then {
                      stop_rounds = stop_rounds + 1
                      options.show(opts, "\n" + ui.note_line(u, "a hook says the work is not finished; comide passes that on"))!
                      go_on = "A check the user set up says the work is not finished:\n" + at_stop.reason
                    }
                  }
                  if go_on == "" then {
                    answer(opts, w.analysis)!
                    done = true
                  } else {
                    if opts.live and string.trim(w.analysis) != "" then println("\n" + convo.answer_lines(u, string.trim(w.analysis), true))
                    list.push(messages, exchange.message("user", (if had_orders then ran.seen + "\n\n" else "") + go_on))
                    asked = false
                    acted = true
                  }
                },
              }
            },
          }
        },
      }
    }
    shell.keep(sh)!
    let _ = fs.write_text(setup.scratch + "/transcript.json", json.stringify(value.array(messages)))
    if steps > 0 then options.show(opts, "\n" + ui.footer(u, steps, tin, tcached, tout, convo.usd(cost), convo.usd(s.cost + cost)))!
    { ...s, messages: messages, cost: s.cost + cost, allow_shell: allow, steps: s.steps + steps, check: work.check,
      goal: if aim_met then "" else s.goal, last_in: last_in }
  }
}

test "the first request is the task, and what follows is said as it was" {
  assert_eq(request([exchange.message("system", "s")], "fix it"), "Task Description:\nfix it")
  assert_eq(request([exchange.message("system", "s"), exchange.message("user", "Task Description:\nfix it")], "now the tests"), "now the tests")
}

test "a declined command says so, with what the person said" {
  assert(string.contains(declined(""), "declined"))
  assert(string.contains(declined("use make instead"), "use make instead"))
}

test "the model is told of every tool but the terminal, with its arguments, and is not asked to be brief" {
  let p = system_prompt("/p", [], false)
  assert(string.contains(p, "- web_search: "))
  assert(not string.contains(system_prompt("/p", ["web_search"], false), "- web_search: "))
  assert(string.contains(p, "<<<BODY hello"))
  assert(string.contains(p, "- edit: "))
  assert(string.contains(p, "- solve: "))
  assert(string.contains(p, "- mcp_call: "))
  assert(string.contains(p, "    path (string): "))
  assert(string.contains(p, ", optional): "))
  assert(not string.contains(p, "- shell: "))
  assert(string.contains(p, "{\"tool\": \"NAME\", \"args\": {...}}"))
  assert(not string.contains(string.to_lower(p), "be brief"))
  assert(not string.contains(string.to_lower(p), "concise"))
}

test "a command failed when its last line is an exit code that is not zero" {
  assert(command_failed("boom\n[exit code 2]"))
  assert(not command_failed("fine\n[exit code 0]"))
  assert(not command_failed("[still running after 5 s, as job 3]"))
}
