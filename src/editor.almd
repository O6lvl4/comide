// The input box: a line editor that comide draws itself, in the shape Claude Code made
// familiar. A rounded box that grows with the text, a dim line under it with the model,
// the project and the cost, and slash commands listed as they are typed.
//
// Everything that decides what the text becomes or where the cursor sits is a pure
// function over `Ed`, so it is tested without a terminal. `prompt` is the one effect:
// it reads keys (term.almd) and redraws the box after each.
//
//   ← → Home End, Ctrl+A/E           move; Alt+← → (or Alt+B/F) by word
//   Backspace Delete, Ctrl+U/K/W     delete; to line start, to line end, a word back
//   ↑ ↓                              between lines of the text, then through history
//   Shift+Enter, Alt+Enter, or \ then Enter   a new line in the text
//   Enter                            send
//   Tab                              complete a slash command, or a file's name after @
//   Ctrl+L                           clear the screen
//   Ctrl+C                           clear the text; on an empty box, twice to leave
//   Ctrl+D                           on an empty box, leave

import io
import fs
import env
import json
import process
import self.term
import self.textbox
import self.ui

type Command = { name: String, about: String }

fn matching(commands: List[Command], typed: String) -> List[Command] =
  if not string.starts_with(typed, "/") or string.contains(typed, " ") or string.contains(typed, "\n") then []
  else list.filter(commands, (c) => string.starts_with(c.name, typed))

type Frame = { lines: List[String], line: Int, col: Int }

// The box, the status line and any command hints; `line` and `col` are where the
// cursor goes, counted from the frame's first line.
fn frame(u: ui.Ui, e: Ed, placeholder: String, status: String, commands: List[Command]) -> Frame = {
  let w = int.max(10, u.width - 6)
  let lay = textbox.layout(e, w)
  var lines = [ui.dim(u, "╭" + string.repeat("─", u.width - 2) + "╮")]
  var i = 0
  for r in lay.rows {
    let lead = if i == 0 then ui.cyan(u, "❯") else " "
    let shown = if list.is_empty(e.chars) and i == 0 then ui.dim(u, string.take(placeholder, w)) else r
    let used = if list.is_empty(e.chars) and i == 0 then ui.columns(string.take(placeholder, w)) else ui.columns(r)
    list.push(lines, ui.dim(u, "│") + " " + lead + " " + shown + string.repeat(" ", int.max(0, w - used)) + " " + ui.dim(u, "│"))
    i = i + 1
  }
  list.push(lines, ui.dim(u, "╰" + string.repeat("─", u.width - 2) + "╯"))
  list.push(lines, "  " + ui.dim(u, ui.fit(status, u.width - 3)))
  for c in list.take(matching(commands, textbox.text(e)), 8) {
    list.push(lines, "  " + ui.cyan(u, string.pad_end(c.name, 14, " ")) + ui.dim(u, ui.fit(c.about, u.width - 18)))
  }
  Frame { lines: lines, line: 1 + lay.row, col: 4 + lay.col }
}

// ---- drawing ---------------------------------------------------------------------------

// Redraws a frame over the last one. `above` is how many lines the cursor sits below the
// top of what was drawn last time; the new value is returned for the next redraw.
effect fn draw(above: Int, f: Frame) -> Int = {
  let back = if above > 0 then "\u{1b}[" + int.to_string(above) + "A" else ""
  let up = list.len(f.lines) - 1 - f.line
  io.print("\u{1b}[?25l" + back + "\r\u{1b}[J" + list.join(f.lines, "\n")
    + (if up > 0 then "\u{1b}[" + int.to_string(up) + "A" else "") + "\r"
    + (if f.col > 0 then "\u{1b}[" + int.to_string(f.col) + "C" else "") + "\u{1b}[?25h")
  f.line
}

// Takes the frame off the screen, leaving the cursor where it began.
effect fn erase(above: Int) -> Unit =
  io.print((if above > 0 then "\u{1b}[" + int.to_string(above) + "A" else "") + "\r\u{1b}[J")

// What was sent, left in the scrollback the way Claude Code leaves it.
fn echo(u: ui.Ui, s: String) -> String = {
  var out: List[String] = []
  var i = 0
  for l in string.split(s, "\n") {
    list.push(out, (if i == 0 then ui.dim(u, "❯ ") else "  ") + ui.dim(u, l))
    i = i + 1
  }
  list.join(out, "\n")
}

// ---- history ---------------------------------------------------------------------------

// One JSON string per line, so a request that spans lines stays one entry.
effect fn load_history(path: String) -> List[String] =
  match fs.read_text(path) {
    err(_) => [],
    ok(t) => list.take(list.reverse(list.filter_map(string.split(t, "\n"), (l) =>
      match json.parse(l) { ok(v) => match value.as_string(v) { ok(s) => some(s), err(_) => none }, err(_) => none })), 500) |> list.reverse,
  }

effect fn remember(path: String, s: String) -> Unit = {
  let _ = fs.append_text(path, json.stringify(value.string(s)) + "\n")
  ()
}

// ---- the loop ----------------------------------------------------------------------------

// "send" with the text, "leave" for Ctrl+D or a second Ctrl+C on an empty box.
type Prompted = { kind: String, text: String }

type Box = { ed: Ed, above: Int, history_at: Int, draft: String, armed: Bool }

// `initial` is what the box holds when it opens, "" for nothing.
// `root` is the project, for Tab after `@` to complete a file's name; "" for none.
effect fn prompt(u: ui.Ui, history: List[String], placeholder: String, status: String, commands: List[Command], initial: String, root: String) -> Prompted = {
  var b = Box { ed: if initial == "" then textbox.empty() else textbox.of(initial), above: 0, history_at: list.len(history), draft: "", armed: false }
  var result: Prompted? = none
  // Only while the box is read: a program run in a turn must not be left with keys told
  // in a way it does not know.
  term.keys_on()!
  b = Box { ed: b.ed, above: draw(0, frame(u, b.ed, placeholder, status, commands))!, history_at: b.history_at, draft: b.draft, armed: b.armed }
  while option.is_none(result) {
    let k = term.read_key()!
    if k.kind == "ctrl" and k.text == "v" then {
      // Ctrl+V: an image on the clipboard becomes a file, named in the text with @.
      let file = pasted_image()!
      b = redrawn(u, if file == "" then b else with_ed(b, textbox.insert(b.ed, "@" + file + " ")), k, placeholder,
        if file == "" then "there is no image on the clipboard (text is pasted with the terminal's own paste)" else "pasted as " + file, commands)!
    }
    let named = if k.kind == "tab" and root != "" then mention(textbox.text(b.ed), b.ed.cursor == list.len(b.ed.chars)) else none
    if option.is_some(named) then {
      let (ed, said) = file_completed(root, b.ed, named ?? "")!
      b = redrawn(u, with_ed(b, ed), k, placeholder, if said == "" then status else said, commands)!
    } else if k.kind != "none" and not (k.kind == "ctrl" and k.text == "v") then {
      let (next, done) = on_key(b, k, history, commands)
      match done {
        some(p) => {
          erase(next.above)!
          if p.kind == "send" then println(echo(u, p.text))
          result = some(p)
        },
        none => { b = redrawn(u, next, k, placeholder, status, commands)! },
      }
    }
  }
  term.keys_off()!
  result ?? Prompted { kind: "leave", text: "" }
}

// ---- an image pasted --------------------------------------------------------------------

// $1 where the image goes, as PNG. The clipboard is read with what the machine has.
let PASTE = "if command -v pngpaste > /dev/null 2>&1; then pngpaste \"$1\" 2> /dev/null; "
  + "elif command -v osascript > /dev/null 2>&1; then osascript -e 'set f to open for access POSIX file (item 1 of {\"'\"$1\"'\"}) with write permission' -e 'write (the clipboard as «class PNGf») to f' -e 'close access f' > /dev/null 2>&1; "
  + "elif command -v wl-paste > /dev/null 2>&1; then wl-paste -t image/png > \"$1\" 2> /dev/null; "
  + "elif command -v xclip > /dev/null 2>&1; then xclip -selection clipboard -t image/png -o > \"$1\" 2> /dev/null; fi; [ -s \"$1\" ]"

// The image on the clipboard, written to a file of comide's own (~/.comide/pasted), for
// the person only: its path, or "" when the clipboard holds no image.
// COMIDE_PASTE_IMAGE is a command to use instead; it is given the path as $1.
effect fn pasted_image() -> String = {
  let dir = (env.get("HOME") ?? "") + "/.comide/pasted"
  let file = dir + "/" + int.to_string(datetime.now_ms()) + ".png"
  let own = string.trim(env.get("COMIDE_PASTE_IMAGE") ?? "")
  let script = "umask 077; mkdir -p \"$2\"; " + (if own == "" then PASTE else own + "; [ -s \"$1\" ]") + " || { rm -f \"$1\"; exit 1; }"
  match process.output(process.ProcessCommand { cmd: "bash", args: ["-c", script, "comide", file, dir], timeout_ms: 5000 }) {
    ok(st) => if st.code == 0 then file else "",
    err(_) => "",
  }
}

// ---- a file named with @ ---------------------------------------------------------------

// What is being typed after an `@` at the end of the text: the beginning of a file's
// name. None when the last word does not start with `@`, or the cursor is not at the end.
fn mention(text: String, at_end: Bool) -> String? =
  if not at_end then none
  else string.strip_prefix(list.last(string.split(string.replace(text, "\n", " "), " ")) ?? "", "@")

// What a list of names all begin with.
fn common(names: List[String]) -> String = {
  var p = list.first(names) ?? ""
  for n in names { while p != "" and not string.starts_with(n, p) { p = string.drop_end(p, 1) } }
  p
}

// The text with the name after `@` completed as far as the project's files settle it,
// and what to say under the box: the names it could still be, or that there is none.
effect fn file_completed(root: String, e: textbox.Ed, prefix: String) -> (textbox.Ed, String) = {
  let script = "cd \"$1\" 2> /dev/null || exit 0; compgen -f -- \"$2\" | head -60 | while IFS= read -r f; do if [ -d \"$f\" ]; then printf '%s/\\n' \"$f\"; else printf '%s\\n' \"$f\"; fi; done"
  let out = match process.output(process.ProcessCommand { cmd: "bash", args: ["-c", script, "comide", root, prefix], timeout_ms: 3000 }) { ok(st) => st.stdout, err(_) => "" }
  let names = list.filter(string.split(out, "\n"), (n) => n != "")
  if list.is_empty(names) then (e, "no file here begins with " + prefix)
  else {
    let one = list.len(names) == 1
    let to = if one then (list.first(names) ?? "") + (if string.ends_with(list.first(names) ?? "", "/") then "" else " ") else common(names)
    let text = textbox.text(e)
    let done = textbox.of(string.drop_end(text, string.len(prefix)) + to)
    (done, if one then "" else list.join(list.map(list.take(names, 8), (n) => list.last(string.split(string.strip_suffix(n, "/") ?? n, "/")) ?? n), "  ")
      + (if list.len(names) > 8 then "  …" else ""))
  }
}

// The box drawn again after a key that did not end the prompt. Ctrl+L clears the screen
// first; an armed Ctrl+C says so in the status line.
effect fn redrawn(u: ui.Ui, b: Box, k: term.Key, placeholder: String, status: String, commands: List[Command]) -> Box = {
  let clear = k.kind == "ctrl" and k.text == "l"
  if clear then io.print("\u{1b}[2J\u{1b}[H")
  let shown_status = if b.armed then "press Ctrl+C again to leave" else status
  Box { ed: b.ed, above: draw(if clear then 0 else b.above, frame(u, b.ed, placeholder, shown_status, commands))!, history_at: b.history_at, draft: b.draft, armed: b.armed }
}

fn with_ed(b: Box, e: textbox.Ed) -> Box = Box { ed: e, above: b.above, history_at: b.history_at, draft: b.draft, armed: false }

// The keys that only edit the text, by the kind term.almd gives them, and the Ctrl
// letters that do the same.
let KEY_EDITS = [("backspace", textbox.backspace), ("delete", textbox.delete), ("left", textbox.left), ("right", textbox.right),
  ("home", textbox.home), ("end", textbox.end), ("wordleft", textbox.word_left), ("wordright", textbox.word_right),
  ("delete_word", textbox.delete_word)]

let CTRL_EDITS = [("a", textbox.home), ("e", textbox.end), ("b", textbox.left), ("f", textbox.right),
  ("u", textbox.kill_to_start), ("k", textbox.kill_to_end), ("w", textbox.delete_word)]

// The text after a key that only edits it, or none for a key that does more.
fn edited(k: term.Key, e: textbox.Ed) -> textbox.Ed? =
  if k.kind == "char" or k.kind == "paste" then some(textbox.insert(e, k.text))
  else if k.kind == "newline" then some(textbox.insert(e, "\n"))
  else {
    let (table, name) = if k.kind == "ctrl" then (CTRL_EDITS, k.text) else (KEY_EDITS, k.kind)
    option.map(list.find(table, (row) => row.0 == name), (row) => row.1(e))
  }

// What a key does to the box, and whether it ends the prompt. Pure, so the whole
// editing surface is tested key by key.
fn on_key(b: Box, k: term.Key, history: List[String], commands: List[Command]) -> (Box, Prompted?) =
  match edited(k, b.ed) {
    some(e) => (with_ed(b, e), none),
    none => if k.kind == "enter" then on_enter(b)
      // Esc on an empty box gives up on it: a question can be skipped, the main prompt
      // simply comes back.
      else if k.kind == "esc" then (b, if list.is_empty(b.ed.chars) then some(Prompted { kind: "skip", text: "" }) else none)
      else if k.kind == "tab" then (completed(b, commands), none)
      else if k.kind == "up" then (earlier(b, history), none)
      else if k.kind == "down" then (later(b, history), none)
      else if k.kind == "ctrl" then on_ctrl(b, k.text)
      else (b, none),
  }

// Enter sends; after a trailing backslash it starts a new line instead.
fn on_enter(b: Box) -> (Box, Prompted?) = {
  let e = b.ed
  let t = textbox.text(e)
  if string.ends_with(t, "\\") and e.cursor == list.len(e.chars) then (with_ed(b, textbox.insert(textbox.backspace(e), "\n")), none)
  else if string.trim(t) == "" then (b, none)
  else (b, some(Prompted { kind: "send", text: t }))
}

fn completed(b: Box, commands: List[Command]) -> Box = match list.first(matching(commands, textbox.text(b.ed))) {
  some(c) => with_ed(b, textbox.of(c.name + " ")),
  none => b,
}

// ↑ past the first line of the text: the entry before in history, the unsent text kept.
fn earlier(b: Box, history: List[String]) -> Box = match textbox.up(b.ed) {
  some(moved) => with_ed(b, moved),
  none => if b.history_at > 0 then {
    let draft = if b.history_at == list.len(history) then textbox.text(b.ed) else b.draft
    Box { ed: textbox.of(list.get(history, b.history_at - 1) ?? ""), above: b.above, history_at: b.history_at - 1, draft: draft, armed: false }
  } else b,
}

// ↓ past the last line: the entry after, and past the newest the unsent text again.
fn later(b: Box, history: List[String]) -> Box = match textbox.down(b.ed) {
  some(moved) => with_ed(b, moved),
  none => if b.history_at < list.len(history) then {
    let n = b.history_at + 1
    let shown = if n == list.len(history) then b.draft else list.get(history, n) ?? ""
    Box { ed: textbox.of(shown), above: b.above, history_at: n, draft: b.draft, armed: false }
  } else b,
}

// Ctrl+D leaves from an empty box and deletes otherwise; Ctrl+C clears the text, and on
// an empty box arms, then leaves.
fn on_ctrl(b: Box, letter: String) -> (Box, Prompted?) = {
  let e = b.ed
  let blank = list.is_empty(e.chars)
  if letter == "d" then (if blank then (b, some(Prompted { kind: "leave", text: "" })) else (with_ed(b, textbox.delete(e)), none))
  else if letter != "c" then (b, none)
  else if not blank then (with_ed(b, textbox.empty()), none)
  else if b.armed then (b, some(Prompted { kind: "leave", text: "" }))
  else (Box { ed: e, above: b.above, history_at: b.history_at, draft: b.draft, armed: true }, none)
}

// ---- choosing one of a few --------------------------------------------------------------

// A menu under a question: ↑ ↓ and Enter, or the number. Esc and Ctrl+C choose none,
// which is -1. The choice stays on the screen as one line.
effect fn choose(u: ui.Ui, question: String, options: List[String]) -> Int = {
  var sel = 0
  var picked: Int? = none
  var above = 0
  while option.is_none(picked) {
    let lines = menu(u, question, options, sel)
    above = draw(above, Frame { lines: lines, line: list.len(lines) - 1, col: 0 })!
    let k = next_key()!
    let (s, p) = menu_key(k, sel, list.len(options))
    sel = s
    picked = p
  }
  let p = picked ?? -1
  erase(above)!
  println("  " + ui.dim(u, "⎿ ") + ui.bold(u, question) + " " + ui.dim(u, if p < 0 then "declined" else list.get(options, p) ?? ""))
  p
}

effect fn next_key() -> term.Key = {
  var k = term.read_key()!
  while k.kind == "none" { k = term.read_key()! }
  k
}

fn menu(u: ui.Ui, question: String, options: List[String], sel: Int) -> List[String] = {
  var lines = ["  " + ui.dim(u, "⎿ ") + ui.bold(u, question)]
  var i = 0
  for o in options {
    list.push(lines, (if i == sel then "   " + ui.cyan(u, "❯ " + int.to_string(i + 1) + ". " + o) else "     " + ui.dim(u, int.to_string(i + 1) + ".") + " " + o))
    i = i + 1
  }
  lines + ["  " + ui.dim(u, "↑↓ to choose · enter to confirm · esc to decline")]
}

// A key at the menu: the selection after it, and the choice if it made one (-1: none).
fn menu_key(k: term.Key, sel: Int, n: Int) -> (Int, Int?) = {
  let digit = int.parse(k.text) ?? 0
  if k.kind == "up" then (if sel == 0 then n - 1 else sel - 1, none)
  else if k.kind == "down" or k.kind == "tab" then ((sel + 1) % n, none)
  else if k.kind == "enter" then (sel, some(sel))
  else if k.kind == "esc" or (k.kind == "ctrl" and k.text == "c") then (sel, some(-1))
  else if k.kind == "char" and digit >= 1 and digit <= n then (sel, some(digit - 1))
  else (sel, none)
}

test "a file's name is being typed after @, at the end of the text" {
  assert_eq(mention("look at @src/ma", true), some("src/ma"))
  assert_eq(mention("look at @", true), some(""))
  assert_eq(mention("look at src", true), none)
  assert_eq(mention("look at @src", false), none)
  assert_eq(common(["src/main.almd", "src/map.almd"]), "src/ma")
  assert_eq(common(["a", "b"]), "")
}
