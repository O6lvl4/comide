// golemancer — many golems, one will.
//
// A coding conversation in the terminal (agent.almd) that hands code changes to
// golemide. `gmc` is its short name.

import process
import self.agent

let USAGE = """
gmc                                  a coding conversation in this directory
gmc run PROMPT [--root DIR] ...      one request, answered, then exit
gmc --help                           every option

golemancer is the same program; gmc is its short name.
"""

// `gmc` alone is the conversation, the way `claude` is: the thing typed most should be
// the shortest. `run PROMPT` is `-p PROMPT` spelled as a verb. Anything else that is
// not an option is a mistake, said as one.
local fn chat_args(args: List[String]) -> List[String]? = {
  let first = list.get(args, 1) ?? ""
  if first == "run" then some(["-p"] + list.drop(args, 2))
  else if first == "chat" then some(list.drop(args, 2))
  else if first == "" or string.starts_with(first, "-") then some(list.drop(args, 1))
  else none
}

effect fn main() -> Unit = {
  match chat_args(process.args()) {
    some(rest) => process.exit(agent.cli(rest)!),
    none => {
      eprintln("unknown command: " + (list.get(process.args(), 1) ?? ""))
      eprintln(USAGE)
      process.exit(2)
    },
  }
}

test "gmc alone is the conversation; run is one request; a bare word is a mistake" {
  assert_eq(chat_args(["gmc"]), some([]))
  assert_eq(chat_args(["gmc", "run", "fix the flaky tests"]), some(["-p", "fix the flaky tests"]))
  assert_eq(chat_args(["gmc", "run", "fix it", "--yes"]), some(["-p", "fix it", "--yes"]))
  assert_eq(chat_args(["gmc", "-p", "fix it"]), some(["-p", "fix it"]))
  assert_eq(chat_args(["gmc", "--root", "../x"]), some(["--root", "../x"]))
  assert_eq(chat_args(["gmc", "--help"]), some(["--help"]))
  assert_eq(chat_args(["gmc", "chat", "--yes"]), some(["--yes"]))
  assert_eq(chat_args(["gmc", "claims.json"]), none)
}
