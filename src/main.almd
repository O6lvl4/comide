// comide — a coding agent in the terminal.
//
// A coding conversation (agent.almd) that hands its code changes to golemide.

import process
import self.agent

let USAGE = """
comide                              a coding conversation in this directory
comide run PROMPT [--root DIR] ...  one request, answered, then exit
comide --help                       every option
"""

// `comide` alone is the conversation, the way `claude` is: the thing typed most should be
// the shortest. `run PROMPT` is `-p PROMPT` spelled as a verb. Anything else that is
// not an option is a mistake, said as one.
local fn chat_args(args: List[String]) -> List[String]? = {
  let first = list.get(args, 1) ?? ""
  if first == "run" then some(["-p"] + list.drop(args, 2))
  else if first == "chat" then some(list.drop(args, 2))
  else if first == "" or string.starts_with(first, "-") then some(list.drop(args, 1))
  else none
}

effect fn main() -> Unit = {
  match chat_args(process.args()) {
    some(rest) => process.exit(agent.cli(rest)!),
    none => {
      eprintln("unknown command: " + (list.get(process.args(), 1) ?? ""))
      eprintln(USAGE)
      process.exit(2)
    },
  }
}

test "comide alone is the conversation; run is one request; a bare word is a mistake" {
  assert_eq(chat_args(["comide"]), some([]))
  assert_eq(chat_args(["comide", "run", "fix the flaky tests"]), some(["-p", "fix the flaky tests"]))
  assert_eq(chat_args(["comide", "run", "fix it", "--yes"]), some(["-p", "fix it", "--yes"]))
  assert_eq(chat_args(["comide", "-p", "fix it"]), some(["-p", "fix it"]))
  assert_eq(chat_args(["comide", "--root", "../x"]), some(["--root", "../x"]))
  assert_eq(chat_args(["comide", "--help"]), some(["--help"]))
  assert_eq(chat_args(["comide", "chat", "--yes"]), some(["--yes"]))
  assert_eq(chat_args(["comide", "claims.json"]), none)
}
