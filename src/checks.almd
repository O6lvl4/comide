// How a project checks its own work, read from its files before the conversation starts.
//
// solve needs a verify command, and the model has to find it. Measured 2026-09-24 on 56
// polyglot exercises with the command left out of the prompt: go, java and javascript
// found theirs from the test file, but C++ did not. The model handed solve a plain
// `cmake --build build` with nothing configured, golemide reported the harness broken
// before its first attempt, twice, and the model wrote the solver itself for $0.54 and
// failed. The CMakeLists said what to run; nothing read it.
//
// Two things are read. The command a build file implies (Cargo.toml, go.mod, package.json,
// a pytest layout, Gradle, Maven, CMake, a Makefile test target, almide.toml). And the
// tests that are there but switched off: `#[ignore]`, `xtest(`, `.skip(`, `@Disabled`,
// `@skip`, and C/C++ tests behind an `#if` on a switch the CMakeLists also reads. A run
// with those off passes with most of the tests never run.

import json

type Candidate = { command: String, from: String, note: String }

type Facts = { files: List[String], cmake: String, package_json: String, makefile: String, markers: List[String] }

fn has(files: List[String], name: String) -> Bool = list.contains(files, name)

fn any_file(files: List[String], pred: (String) -> Bool) -> Bool = list.any(files, pred)

fn count_of(markers: List[String], pred: (String) -> Bool) -> Int = list.len(list.filter(markers, pred))

fn plural(n: Int, one: String) -> String = int.to_string(n) + " " + one + (if n == 1 then "" else "s")

// The switches test cases sit behind that the CMakeLists also reads. A marker
// "#gate NAME" is a test case inside `#if`/`#ifdef` on NAME (GATES_AWK); a switch that
// only picks a header, as EXERCISM_TEST_SUITE does in the polyglot C++ tests, is no gate.
fn cmake_switches(f: Facts) -> List[String] = {
  var out: List[String] = []
  for m in f.markers {
    if string.starts_with(m, "#gate ") then {
      let name = string.trim(string.drop(m, 6))
      if name != "" and string.contains(f.cmake, name) and not list.contains(out, name) then list.push(out, name) else ()
    } else ()
  }
  out
}

fn cmake_candidate(f: Facts) -> Candidate = {
  let switches = cmake_switches(f)
  let defines = string.join(list.map(switches, (s) => " -D" + s + "=ON"), "")
  let configure = "cmake -S . -B build" + defines + " && cmake --build build"
  let lower = string.to_lower(f.cmake)
  let with_ctest = string.contains(lower, "add_test(") or string.contains(lower, "enable_testing(")
  let runs_on_build = string.contains(lower, "add_custom_target(") and string.contains(lower, " all ")
  Candidate {
    command: if with_ctest then configure + " && ctest --test-dir build --output-on-failure" else configure,
    from: "CMakeLists.txt",
    note: (if list.is_empty(switches) then "" else "the tests read " + string.join(switches, ", ") + ", which is off unless set; without it most of them are compiled out. ")
      + (if runs_on_build then "the build itself runs the test program." else if with_ctest then "" else "if the build does not run the tests, run the test program it builds."),
  }
}

fn js_note(f: Facts) -> String = {
  let skipped = count_of(f.markers, (m) => string.starts_with(m, "xtest(") or string.starts_with(m, "xit(") or string.starts_with(m, "xdescribe(") or string.ends_with(m, ".skip("))
  if skipped == 0 then "" else plural(skipped, "test") + " are switched off with xtest / xit / .skip: turn them back on (xtest( to test(), or they never run."
}

fn candidates(f: Facts) -> List[Candidate] = {
  var out: List[Candidate] = []
  let ignored = count_of(f.markers, (m) => m == "#[ignore]")
  if has(f.files, "Cargo.toml") then list.push(out, Candidate {
    command: if ignored > 0 then "cargo test -- --include-ignored" else "cargo test", from: "Cargo.toml",
    note: if ignored > 0 then plural(ignored, "test") + " marked #[ignore]; --include-ignored runs them." else "" }) else ()
  if has(f.files, "go.mod") then list.push(out, Candidate { command: "go test ./...", from: "go.mod", note: "" }) else ()
  if has(f.files, "package.json") then {
    let script = match json.parse(f.package_json) {
      ok(p) => match value.field(p, "scripts") { ok(s) => json.get_string(s, "test") ?? "", err(_) => "" },
      err(_) => "",
    }
    if script != "" then list.push(out, Candidate { command: "npm test", from: "package.json (test: " + script + ")", note: js_note(f) }) else ()
  } else ()
  let python_tests = any_file(f.files, (n) => (string.starts_with(n, "test_") or string.ends_with(n, "_test.py")) and string.ends_with(n, ".py"))
  if has(f.files, "pytest.ini") or has(f.files, "pyproject.toml") or has(f.files, "setup.cfg") or has(f.files, "tox.ini") or python_tests then {
    let skipped = count_of(f.markers, (m) => string.contains(m, "skip"))
    list.push(out, Candidate { command: "python3 -m pytest -q", from: if python_tests then "the test_*.py / *_test.py files" else "the Python project files",
      note: if skipped > 0 then plural(skipped, "skip marker") + " in the tests (@skip / @pytest.mark.skip)." else "" })
  } else ()
  let disabled = count_of(f.markers, (m) => m == "@Disabled" or m == "@Ignore")
  let java_note = if disabled > 0 then plural(disabled, "test") + " marked @Disabled / @Ignore: they never run until the mark is taken off." else ""
  if has(f.files, "gradlew") then list.push(out, Candidate { command: "./gradlew test --console=plain", from: "gradlew", note: java_note })
  else if has(f.files, "build.gradle") or has(f.files, "build.gradle.kts") then list.push(out, Candidate { command: "gradle test --console=plain", from: "build.gradle", note: java_note })
  else ()
  if has(f.files, "pom.xml") then list.push(out, Candidate { command: "mvn -q test", from: "pom.xml", note: java_note }) else ()
  if has(f.files, "CMakeLists.txt") then list.push(out, cmake_candidate(f)) else ()
  if has(f.files, "Makefile") and (string.contains(f.makefile, "\ntest:") or string.starts_with(f.makefile, "test:")) then
    list.push(out, Candidate { command: "make test", from: "Makefile", note: "" }) else ()
  if has(f.files, "almide.toml") then list.push(out, Candidate { command: "almide test", from: "almide.toml", note: "" }) else ()
  out
}

fn described(cs: List[Candidate]) -> String =
  if list.is_empty(cs) then ""
  else "How this project checks its work, as its files suggest (a starting point for solve's verify; confirm it runs the tests):\n"
    + string.join(list.map(cs, (c) => "- `" + c.command + "`  (from " + c.from + ")" + (if c.note == "" then "" else "\n  " + c.note)), "\n")

// What the files say: the names at the top of the project, the build files, and the
// markers of switched-off tests anywhere under it except dependency and build output.
let MARKERS = "#\\[ignore\\]|\\bx(test|it|describe)\\(|\\b(test|it|describe)\\.skip\\(|@Disabled|@Ignore\\b|@(unittest\\.|pytest\\.mark\\.)?skip"

// For C and C++ test files: "#gate NAME" for each test case inside an `#if` on NAME.
let GATES_AWK = "/^[ \\t]*#[ \\t]*(if|ifdef|elif)[ \\t]/ { l = $0; gsub(/[()!]/, \" \", l); n = split(l, w, /[ \\t]+/); cur = \"\"; for (i = 1; i <= n; i++) if (w[i] ~ /^[A-Z_][A-Z0-9_]*$/) { cur = w[i]; break } next } /^[ \\t]*#[ \\t]*(else|endif)/ { cur = \"\"; next } cur != \"\" && /(TEST_CASE|TEST|TEST_F|SECTION|SCENARIO)[ \\t]*\\(/ { print \"#gate \" cur }"

fn quote(path: String) -> String = "'" + string.replace(path, "'", "'\\''") + "'"

// The shell command that finds the markers under root.
fn markers_command(root: String) -> String =
  "grep -rhoE --exclude-dir=node_modules --exclude-dir=target --exclude-dir=build --exclude-dir=.git --exclude-dir=vendor --exclude-dir=dist "
    + "--include='*test*' --include='*spec*' --include='*Test*' -m 200 '" + MARKERS + "' " + quote(root) + " 2>/dev/null | head -500; "
    + "find " + quote(root) + " -maxdepth 3 -type f \\( -name '*test*.c' -o -name '*test*.cc' -o -name '*test*.cpp' -o -name '*test*.cxx' \\) -not -path '*/build/*' -exec awk '" + GATES_AWK + "' {} + 2>/dev/null | sort -u"

fn lines_of(s: String) -> List[String] = list.filter(list.map(string.split(s, "\n"), (l) => string.trim(l)), (l) => l != "")

test "a CMake project whose tests hide behind a switch gets the switch" {
  let cmake = "if(EXERCISM_RUN_ALL_TESTS)\n  target_compile_definitions(x PRIVATE EXERCISM_RUN_ALL_TESTS)\nendif()\nadd_custom_target(test_x ALL DEPENDS x COMMAND x)\n"
  let f = Facts { files: ["CMakeLists.txt", "zebra_puzzle.h", "zebra_puzzle_test.cpp"], cmake: cmake, package_json: "", makefile: "",
    markers: ["#gate EXERCISM_RUN_ALL_TESTS", "#gate NOT_IN_CMAKE"] }
  let cs = candidates(f)
  assert_eq(list.len(cs), 1)
  let c = list.first(cs) ?? Candidate { command: "", from: "", note: "" }
  assert_eq(c.command, "cmake -S . -B build -DEXERCISM_RUN_ALL_TESTS=ON && cmake --build build")
  assert(string.contains(c.note, "the build itself runs the test program"))
}

test "ctest when the CMakeLists registers tests" {
  let f = Facts { files: ["CMakeLists.txt"], cmake: "enable_testing()\nadd_test(NAME t COMMAND t)\n", package_json: "", makefile: "", markers: [] }
  assert_eq((list.first(candidates(f)) ?? Candidate { command: "", from: "", note: "" }).command, "cmake -S . -B build && cmake --build build && ctest --test-dir build --output-on-failure")
}

test "ignored Rust tests and switched-off JS tests are named" {
  let rust = candidates(Facts { files: ["Cargo.toml", "src", "tests"], cmake: "", package_json: "", makefile: "", markers: ["#[ignore]", "#[ignore]"] })
  assert_eq((list.first(rust) ?? Candidate { command: "", from: "", note: "" }).command, "cargo test -- --include-ignored")
  let js = candidates(Facts { files: ["package.json", "react.spec.js"], cmake: "", package_json: "{\"scripts\":{\"test\":\"jest ./*\"}}", makefile: "", markers: ["xtest(", "xtest(", "test.skip("] })
  let c = list.first(js) ?? Candidate { command: "", from: "", note: "" }
  assert_eq(c.command, "npm test")
  assert(string.starts_with(c.note, "3 tests are switched off"))
}

test "a package.json without a test script suggests nothing" {
  assert(list.is_empty(candidates(Facts { files: ["package.json"], cmake: "", package_json: "{\"scripts\":{\"build\":\"tsc\"}}", makefile: "", markers: [] })))
}

test "go, python, gradle and make" {
  let f = Facts { files: ["go.mod", "forth_test.py", "gradlew", "build.gradle", "Makefile"], cmake: "", package_json: "", makefile: "all:\n\tcc x.c\ntest:\n\t./t\n", markers: ["@Disabled"] }
  assert_eq(list.map(candidates(f), (c) => c.command), ["go test ./...", "python3 -m pytest -q", "./gradlew test --console=plain", "make test"])
  assert(string.contains(described(candidates(f)), "1 test marked @Disabled"))
}
