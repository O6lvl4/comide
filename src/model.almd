// One model turn with tools, through almai.live (almide-ai/almai).
//
// almai.live holds the providers and the call: model ids (cf:..., openai:..., any
// NAME: with NAME_BASE_URL and NAME_API_KEY, claude[:MODEL] for Claude Code's claude
// -p), the streamed request running in the background so the answer can be shown as it
// is written and stopped on Esc, curl bounding it in time, the cost from each
// provider's own meter. The same module serves golemide, so one model id means the same
// in both. What stays here are the names the loop uses, and two choices of comide's:
//   - reasoning effort goes to Cloudflare only; elsewhere it is an error on a model that
//     does not reason
//   - claude -p keeps its session between the calls of one comide process, in the
//     scratch directory, so each call sends only what is new

import almai.live as live

// `arguments` is the JSON text the model wrote, parsed only when the tool runs, so a
// malformed one can be answered as a tool error the model reads, not a crash.
type ToolCall = { id: String, name: String, arguments: String }
type Reply = { content: String, reasoning: String, calls: List[ToolCall], finish: String,
  cost_usd: Float, input_tokens: Int, cached_tokens: Int, output_tokens: Int, ms: Int }

type Call = { pending: live.Pending }

let LIMITS = live.Limits { total_s: 900, idle_s: 120 }

// Where a model id goes, checked at start and on /model: a missing key is one line.
effect fn endpoint_of(model: String) -> Result[Unit, String] = {
  let _ = live.endpoint(model)!
  ok(())
}

fn effort_for(model: String, effort: String) -> String =
  if (live.split_model(model)).0 == "cf" then effort else ""

effect fn start(model: String, messages: List[Value], tools: List[Value], max_tokens: Int, effort: String, scratch: String) -> Result[Call, String] = {
  let p = live.start(live.Request { model: model, messages: messages, tools: tools, max_tokens: max_tokens,
    effort: effort_for(model, effort), session: scratch + "/claude-session.json" }, LIMITS)!
  ok(Call { pending: p })
}

effect fn is_done(c: Call) -> Bool = live.is_done(c.pending)!

effect fn text_so_far(c: Call) -> String = live.text_so_far(c.pending)!

effect fn abandon(c: Call) -> Unit = live.cancel(c.pending)!

effect fn settle(c: Call) -> Result[Reply, String] = {
  let r = live.finish(c.pending)!
  ok(Reply { content: r.content, reasoning: r.reasoning, calls: list.map(r.calls, (t) => ToolCall { id: t.id, name: t.name, arguments: t.arguments }),
    finish: r.finish, cost_usd: r.cost_usd, input_tokens: r.input_tokens, cached_tokens: r.cached_tokens, output_tokens: r.output_tokens, ms: r.ms })
}

test "reasoning effort goes to Cloudflare only" {
  assert_eq(effort_for("cf:glm-5.3", "low"), "low")
  assert_eq(effort_for("glm-5.3", "low"), "low")
  assert_eq(effort_for("openrouter:x/y", "low"), "")
  assert_eq(effort_for("claude", "low"), "")
}
