// One model call, watched: a spinner while the model is quiet, each whole line of its
// answer as soon as it is written, Esc to stop it, and the call tried again when the
// failure is the provider's or the network's.

import env
import fs
import io
import json
import self.model
import self.tools
import self.ui
import self.term
import self.aside
import self.convo
import self.options

// `interrupted` is the person pressing Esc or Ctrl+C while the model was still answering;
// the reply is then empty and nothing of it is recorded.
type Heard = { reply: model.Reply, printed: Int, interrupted: Bool }

fn no_reply() -> model.Reply = model.Reply { content: "", reasoning: "", calls: [], finish: "", cost_usd: 0.0, input_tokens: 0, cached_tokens: 0, output_tokens: 0, ms: 0 }

// What the screen shows so far: how much of the answer is printed, and whether the
// spinner is on the line.
type Shown = { printed: Int, spinning: Bool }

let CALL_MAX_MS = 930000

// Waits for the request, and in a conversation shows it arriving.
effect fn await_reply(opts: options.Options, c: model.Call) -> Result[Heard, String] = {
  let t0 = datetime.now_ms()
  var shown = Shown { printed: 0, spinning: false }
  var frame = 0
  var interrupted = false
  while not model.is_done(c)! and datetime.now_ms() - t0 <= CALL_MAX_MS and not interrupted {
    interrupted = pause(opts)!
    if opts.live then { shown = progress(opts, c, shown, frame, t0)! }
    frame = frame + 1
  }
  if shown.spinning then io.print(ui.clear_line(opts.ui))
  if interrupted then { model.abandon(c)!; ok(Heard { reply: no_reply(), printed: shown.printed, interrupted: true }) }
  else if not model.is_done(c)! then { model.abandon(c)!; err("request timeout: no complete answer within 930s") }
  else match model.settle(c) {
    err(e) => err(e),
    ok(r) => ok(Heard { reply: r, printed: shown.printed, interrupted: false }),
  }
}

// A tenth of a second's wait. On a taken-over terminal it is a key read with that
// timeout: true when Esc or Ctrl+C was pressed, which stops what is running. Any other
// key is the person saying something while comide works (aside.almd).
effect fn pause(opts: options.Options) -> Bool =
  if opts.tui then aside.key(opts.aside, term.read_key()!)!
  else {
    env.sleep_ms(100)
    false
  }

// ---- said while comide works (aside.almd), as the loops ask about it -------------------

// Whether the request is being stopped to send what was typed at once: asked while the
// request is still being worked, so that it ends there.
effect fn stopping(opts: options.Options) -> Bool = aside.stopping(opts.aside)!

// Whether the request was stopped to send what was typed at once. Asked once: taken.
effect fn stopped_to_send(opts: options.Options) -> Bool = opts.aside != "" and aside.taken(aside.now_file(opts.aside))!

// Whether the request was stopped by the person at all. Asked once: taken.
effect fn was_stopped(opts: options.Options) -> Bool = opts.aside != "" and aside.taken(aside.stopped_file(opts.aside))!

// A question is about to be put to the person (asking.almd). Keys typed for something
// else may still be on their way, and a stray Enter or digit would answer the question:
// "yes, run it", said by accident. So the keys are read until none has come for three
// tenths of a second, and taken as what they were, words said aside. Only then is the
// question open to an answer.
effect fn settled(opts: options.Options) -> Unit =
  if not opts.tui then ()
  else {
    var quiet = 0
    var read = 0
    while quiet < 3 and read < 2000 {
      let k = term.read_key()!
      if k.kind == "none" then { quiet = quiet + 1 }
      else {
        quiet = 0
        read = read + 1
        if opts.aside != "" and k.kind != "esc" and k.kind != "ctrl" then aside.typed(opts.aside, k)!
      }
    }
  }

// What the waiting line says after its own hint.
effect fn hint(opts: options.Options, base: String) -> String = aside.hint(opts.aside, base, opts.ui.width)!

// What was handed over, taken: said to the model as this, and not again.
effect fn told(opts: options.Options) -> String =
  if opts.aside == "" then ""
  else {
    let lines = aside.told(opts.aside)!
    if list.is_empty(lines) then ""
    else {
      aside.lines_out(aside.told_file(opts.aside), [])!
      options.show(opts, "\n" + ui.note_line(opts.ui, "told comide: " + list.join(lines, " / ")))!
      "[While you were working, the user said this. It comes from the user, like the task: take it into account from here on.]\n" + list.join(lines, "\n")
    }
  }

// What is left when a request ends: handed over too late to be told, or typed and
// neither handed over nor put by. Taken, for the input box.
effect fn left(opts: options.Options) -> String =
  if opts.aside == "" then ""
  else {
    let rest = list.filter(aside.told(opts.aside)! + [string.trim(aside.draft(opts.aside)!)], (l) => l != "")
    aside.lines_out(aside.told_file(opts.aside), [])!
    let _ = fs.write_text(opts.aside, "")
    list.join(rest, "\n")
  }

// The first of the lines put by for after the request, taken; "" when there is none.
effect fn next_after(opts: options.Options) -> String =
  if opts.aside == "" then ""
  else {
    let lines = aside.after(opts.aside)!
    if list.is_empty(lines) then ""
    else { aside.lines_out(aside.after_file(opts.aside), list.drop(lines, 1))!; list.first(lines) ?? "" }
  }

// All of the lines put by, taken: a request that was stopped does not go on to them.
effect fn all_after(opts: options.Options) -> String =
  if opts.aside == "" then ""
  else {
    let lines = aside.after(opts.aside)!
    aside.lines_out(aside.after_file(opts.aside), [])!
    list.join(lines, "\n")
  }

// The whole new lines of the answer, or the spinner while there are none yet.
effect fn progress(opts: options.Options, c: model.Call, shown: Shown, frame: Int, t0: Int) -> Shown = {
  let u = opts.ui
  let text = model.text_so_far(c)!
  let upto = match string.last_index_of(text, "\n") { some(i) => i + 1, none => 0 }
  if upto > shown.printed and string.trim(string.slice(text, shown.printed, upto)) != "" then {
    if shown.spinning then io.print(ui.clear_line(u))
    println((if shown.printed == 0 then "\n" else "") + convo.answer_lines(u, string.slice(text, shown.printed, upto), shown.printed == 0))
    Shown { printed: upto, spinning: false }
  } else if shown.printed == 0 and u.color then {
    io.print(ui.waiting(u, frame / 3, (datetime.now_ms() - t0) / 1000, "Thinking", if opts.tui then hint(opts, "esc to interrupt")! else ""))
    Shown { printed: 0, spinning: true }
  } else shown
}

effect fn ask_once(opts: options.Options, scratch: String, messages: List[Value]) -> Result[Heard, String] = {
  let c = model.start(opts.model, messages, tools.definitions(), opts.max_tokens, opts.effort, scratch)!
  await_reply(opts, c)
}

effect fn call_model(opts: options.Options, scratch: String, messages: List[Value], tries: Int) -> Result[Heard, String] =
  match ask_once(opts, scratch, messages) {
    ok(h) => ok(h),
    err(e) => if tries + 1 < convo.MODEL_TRIES and convo.retryable(e) then {
      // A little jitter, so parallel sessions hit by the same outage do not come back
      // in step.
      let wait = convo.retry_wait_ms(tries) + datetime.now_ms() % 1000
      options.show(opts, ui.note_line(opts.ui, string.take(e, 120) + "; trying again in " + int.to_string(wait / 1000) + "s"))!
      env.sleep_ms(wait)
      call_model(opts, scratch, messages, tries + 1)
    } else err(e),
  }
