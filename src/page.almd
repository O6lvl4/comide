// Turning a fetched document into text a figure can be looked for in.
//
// Pure, and separate from the fetching on purpose: whoever read the page — this
// program's own client, or a Worker's host `fetch` — hands the bytes here, and
// both get identical text out. This is the half of the tool that runs where
// there is no socket.
//
// `script` and `style` bodies go before the tags do: a figure inside a tracking
// snippet or a CSS rule must never be allowed to vouch for a claim.

import self.tokens

// Documents past this are truncated. A figure below the cut reads as missing,
// which is a refusal rather than a false pass — the safe direction for a gate.
let MAX_CHARS = 1000000

// Searching and slicing run over the same string. The previous spelling searched a
// `string.to_lower` copy and cut the original, which is wrong whenever case folding
// is not length preserving — and a fetched body can carry replacement characters,
// because the HTTP client decodes invalid UTF-8 lossily where `fs.read_text`
// refuses the file outright. Normalising first removes the divergence.
//
// A pure-regex version of this file was tried and reverted: `(?s)<script.*?>` over a
// 200 KB page overflowed the stack, and the tag pass trapped on wasm. Bounded index
// walking is the version that survives real pages.
local fn drop_blocks(src: String, open_tag: String, close_tag: String) -> String =
  match string.index_of(src, open_tag) {
    none => src,
    some(i) => {
      let head = string.slice(src, 0, i)
      let rest = string.drop(src, i)
      match string.index_of(rest, close_tag) {
        none => head,
        some(j) => head + " " + drop_blocks(string.drop(rest, j + string.len(close_tag)), open_tag, close_tag),
      }
    },
  }

// Everything between `<` and `>` goes, and the tag leaves a space behind so that
// `<td>53</td><td>3</td>` cannot read as the figure "533".
local fn strip_tags(src: String) -> String = {
  var parts: List[String] = []
  var depth = 0
  for c in string.chars(src) {
    if c == "<" then {
      depth = depth + 1
    } else if c == ">" then {
      depth = if depth > 0 then depth - 1 else 0
      list.push(parts, " ")
    } else {
      if depth == 0 then list.push(parts, c) else ()
    }
  }
  string.join(parts, "")
}

// Normalised first: tag names are ASCII, so folding case up front costs nothing and
// gives every index below the same string it was found in.
fn text_of(doc: String) -> String =
  strip_tags(drop_blocks(drop_blocks(tokens.normalize(string.take(doc, MAX_CHARS)), "<script", "</script>"), "<style", "</style>"))

// ---- for reading ------------------------------------------------------------------

// `text_of` is text for matching: lowercased, commas taken out of figures. A person or a
// model reading a page needs the page as it was written, so this keeps case and
// punctuation, turns the ends of blocks into line breaks, decodes the common entities,
// and closes up the blank space tags leave behind. Script and style bodies go here too.
let READABLE_MAX_CHARS = 600000

let BLOCK_ENDS = ["</p>", "</div>", "</li>", "</tr>", "</h1>", "</h2>", "</h3>", "</h4>", "</h5>", "</h6>",
  "</pre>", "</blockquote>", "</section>", "</article>", "</header>", "</footer>", "<br>", "<br/>", "<br />"]

local fn decode_entities(s: String) -> String =
  string.replace(string.replace(string.replace(string.replace(string.replace(string.replace(string.replace(s,
    "&nbsp;", " "), "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&#39;", "'"), "&#x27;", "'"), "&amp;", "&")

fn readable(doc: String) -> String = {
  var s = string.take(doc, READABLE_MAX_CHARS)
  for t in [("<script", "</script>"), ("<style", "</style>"), ("<noscript", "</noscript>"), ("<svg", "</svg>"),
            ("<SCRIPT", "</SCRIPT>"), ("<STYLE", "</STYLE>")] {
    s = drop_blocks(s, t.0, t.1)
  }
  for b in BLOCK_ENDS { s = string.replace(s, b, "\n" + b) }
  let text = decode_entities(strip_tags(s))
  var lines: List[String] = []
  var blank = false
  for l in string.split(text, "\n") {
    let t = string.trim(string.join(list.filter(string.split(string.replace(l, "\t", " "), " "), (w) => w != ""), " "))
    if t == "" then { if not blank and not list.is_empty(lines) then { list.push(lines, ""); blank = true } else () }
    else { list.push(lines, t); blank = false }
  }
  string.trim(string.join(lines, "\n"))
}

test "a page read for reading keeps its words as written, one block to a line" {
  let doc = "<html><head><style>p{color:red}</style><script>var x=1</script></head><body>"
    + "<h1>Almide  0.63</h1><p>Released on   <b>Sept 22</b>.</p><p>Tom &amp; Jerry&nbsp;&lt;3</p></body></html>"
  assert_eq(readable(doc), "Almide 0.63\nReleased on Sept 22 .\nTom & Jerry <3")
}

test "tags go, and leave a boundary where they were" {
  assert_eq(text_of("<td>53</td><td>3</td>"), " 53  3 ")
}

test "figures inside script and style cannot vouch" {
  assert_eq(string.contains(text_of("<script>var x = 53.3</script>ok"), "53.3"), false)
  assert_eq(string.contains(text_of("<style>.a{width:53.3px}</style>ok"), "53.3"), false)
}

test "document text is normalised like the claim" {
  assert_eq(string.contains(text_of("<p>NT$5,148.1 Billion</p>"), "5148.1"), true)
}

test "plain text passes through, lowercased" {
  assert_eq(text_of("Revenue 5,148.1"), "revenue 5148.1")
}
