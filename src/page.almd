// A fetched web page as text a person or a model can read: the page as it was
// written, with case and punctuation kept, the ends of blocks turned into line
// breaks, the common entities decoded, and the blank space tags leave behind
// closed up. Script, style, noscript and svg bodies go first.
//
// A pure-regex version of this was tried and reverted: `(?s)<script.*?>` over a
// 200 KB page overflowed the stack. Bounded index walking is the version that
// survives real pages.

let READABLE_MAX_CHARS = 600000

let BLOCK_ENDS = ["</p>", "</div>", "</li>", "</tr>", "</h1>", "</h2>", "</h3>", "</h4>", "</h5>", "</h6>",
  "</pre>", "</blockquote>", "</section>", "</article>", "</header>", "</footer>", "<br>", "<br/>", "<br />"]

local fn drop_blocks(src: String, open_tag: String, close_tag: String) -> String =
  match string.index_of(src, open_tag) {
    none => src,
    some(i) => {
      let head = string.slice(src, 0, i)
      let rest = string.drop(src, i)
      match string.index_of(rest, close_tag) {
        none => head,
        some(j) => head + " " + drop_blocks(string.drop(rest, j + string.len(close_tag)), open_tag, close_tag),
      }
    },
  }

// Everything between `<` and `>` goes, and the tag leaves a space behind so that
// `<td>53</td><td>3</td>` cannot read as "533".
local fn strip_tags(src: String) -> String = {
  var parts: List[String] = []
  var depth = 0
  for c in string.chars(src) {
    if c == "<" then {
      depth = depth + 1
    } else if c == ">" then {
      depth = if depth > 0 then depth - 1 else 0
      list.push(parts, " ")
    } else {
      if depth == 0 then list.push(parts, c)
    }
  }
  string.join(parts, "")
}

local fn decode_entities(s: String) -> String =
  string.replace(string.replace(string.replace(string.replace(string.replace(string.replace(string.replace(s,
    "&nbsp;", " "), "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&#39;", "'"), "&#x27;", "'"), "&amp;", "&")

fn readable(doc: String) -> String = {
  var s = string.take(doc, READABLE_MAX_CHARS)
  for t in [("<script", "</script>"), ("<style", "</style>"), ("<noscript", "</noscript>"), ("<svg", "</svg>"),
            ("<SCRIPT", "</SCRIPT>"), ("<STYLE", "</STYLE>")] {
    s = drop_blocks(s, t.0, t.1)
  }
  for b in BLOCK_ENDS { s = string.replace(s, b, "\n" + b) }
  let text = decode_entities(strip_tags(s))
  var lines: List[String] = []
  var blank = false
  for l in string.split(text, "\n") {
    let t = string.trim(string.join(list.filter(string.split(string.replace(l, "\t", " "), " "), (w) => w != ""), " "))
    if t == "" then { if not blank and not list.is_empty(lines) then { list.push(lines, ""); blank = true } }
    else { list.push(lines, t); blank = false }
  }
  string.trim(string.join(lines, "\n"))
}

test "a page read for reading keeps its words as written, one block to a line" {
  let doc = "<html><head><style>p{color:red}</style><script>var x=1</script></head><body>"
    + "<h1>Almide  0.63</h1><p>Released on   <b>Sept 22</b>.</p><p>Tom &amp; Jerry&nbsp;&lt;3</p></body></html>"
  assert_eq(readable(doc), "Almide 0.63\nReleased on Sept 22 .\nTom & Jerry <3")
}

test "tags leave a boundary where they were" {
  assert_eq(readable("<td>53</td><td>3</td>"), "53 3")
}
