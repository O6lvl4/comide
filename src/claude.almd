// Claude Code's `claude -p` as comide's model, and nothing more.
//
// comide keeps the loop, the tools, the checks and the permissions; Claude only decides
// the next step. Its own tools are off (--tools ""), no settings, hooks or MCP servers of
// the person's are loaded (--setting-sources "", --strict-mcp-config), and the answer is
// one JSON object written as the reply's text: words for the person, or tool calls for
// comide to run.
//
// As text, not through --json-schema. The schema reaches the model as a tool of its own,
// and a model holding one tool called comide's actions as tools too: "No such tool
// available" for each, then an answer that nothing could be done -- on 2 of 3 runs
// measured 2026-09-25 (claude 2.1.282), however the actions were described. With no
// tool at all, 3 of 3 answered with the JSON in one turn.
//
// The session is continued with --resume, so each call sends only what is new since the
// last one: the tool results and any note comide added. It starts over when there is no
// session yet, when the conversation was cleared, or when the model changed.

import json
import fs

type State = { id: String, sent: Int, model: String }

// What one call amounts to, before model.almd turns it into a Reply.
type Answer = { content: String, calls: List[(String, String)], session: String,
  input_tokens: Int, cached_tokens: Int, output_tokens: Int, cost_usd: Float }

let PROTOCOL = """
How you act here: you are the model inside comide, a coding agent. You have no tools in this session. comide runs the actions listed below for you. Reply with exactly one JSON object and nothing else, no code fence:
{"content": "<words for the user>", "tool_calls": [{"name": "<action>", "arguments": {<its parameters>}}]}
Put the actions you want in tool_calls; several independent ones can go in one reply. comide runs them and sends their results back as the next message. To answer the user, write the answer in content and leave tool_calls empty.
"""

fn str_of(v: Value, key: String) -> String = json.get_string(v, key) ?? ""

fn tools_text(tools: List[Value]) -> String =
  "Actions:\n" + string.join(list.map(tools, (t) => {
    let f = value.field(t, "function") ?? value.object([])
    "- " + str_of(f, "name") + ": " + str_of(f, "description") + "\n  parameters: "
      + json.stringify(value.field(f, "parameters") ?? value.object([]))
  }), "\n")

fn system_text(messages: List[Value], tools: List[Value]) -> String = {
  let first = list.first(messages) ?? value.object([])
  let system = if str_of(first, "role") == "system" then str_of(first, "content") else ""
  system + "\n" + PROTOCOL + "\n" + tools_text(tools)
}

// The name of the call a tool result answers, from the assistant message that made it.
fn call_name(messages: List[Value], id: String) -> String = {
  var name = "tool"
  for m in messages {
    for c in json.get_array(m, "tool_calls") ?? [] {
      if str_of(c, "id") == id then { name = str_of(value.field(c, "function") ?? value.object([]), "name") } else ()
    }
  }
  name
}

// Messages from `from` on, as the text of one prompt. A continued session has its own
// answers already, so they are left out; a fresh one gets the conversation so far.
fn render(messages: List[Value], from: Int, fresh: Bool) -> String = {
  var parts: List[String] = []
  var i = 0
  for m in messages {
    let role = str_of(m, "role")
    if i >= from and role != "system" then {
      if role == "user" then list.push(parts, (if fresh then "User: " else "") + str_of(m, "content"))
      else if role == "tool" then list.push(parts, "Result of " + call_name(messages, str_of(m, "tool_call_id")) + ":\n" + str_of(m, "content"))
      else if role == "assistant" and fresh then {
        let calls = list.map(json.get_array(m, "tool_calls") ?? [], (c) => {
          let f = value.field(c, "function") ?? value.object([])
          str_of(f, "name") + " " + str_of(f, "arguments")
        })
        list.push(parts, "You said: " + str_of(m, "content") + (if list.is_empty(calls) then "" else "\nYou called: " + string.join(calls, "; ")))
      } else ()
    } else ()
    i = i + 1
  }
  string.join(parts, "\n\n")
}

fn state_of(text: String) -> State? = match json.parse(text) {
  ok(v) => if str_of(v, "id") == "" then none else some(State { id: str_of(v, "id"), sent: json.get_int(v, "sent") ?? 0, model: str_of(v, "model") }),
  err(_) => none,
}

fn state_text(s: State) -> String =
  json.stringify(value.object([("id", value.str(s.id)), ("sent", value.int(s.sent)), ("model", value.str(s.model))]))

// The session to continue, if there is one that still matches the conversation.
fn continuing(state: State?, message_count: Int, model: String) -> State? = match state {
  some(s) => if s.model == model and s.sent <= message_count and s.sent > 0 then some(s) else none,
  none => none,
}

fn sh_quote(s: String) -> String = "'" + string.replace(s, "'", "'\\''") + "'"

// The command line, the prompt going on stdin from a file.
fn command(model_id: String, resume: String, system_file: String) -> String = {
  var args = ["claude", "-p", "--output-format", "json", "--tools", "", "--setting-sources", "", "--strict-mcp-config"]
  if model_id != "" then { args = args + ["--model", model_id] } else ()
  if resume != "" then { args = args + ["--resume", resume] } else { args = args + ["--system-prompt-file", system_file] }
  string.join(list.map(args, sh_quote), " ")
}

fn num(v: Value, key: String) -> Int = json.get_int(v, key) ?? float.to_int(json.get_float(v, key) ?? 0.0)

// The JSON object in a reply's text: from the first "{" to the last "}", so a code
// fence or a sentence around it does not matter.
fn object_in(text: String) -> Value? =
  match (string.index_of(text, "{"), string.last_index_of(text, "}")) {
    (some(a), some(b)) => if b > a then (match json.parse(string.slice(text, a, b + 1)) { ok(v) => some(v), err(_) => none }) else none,
    _ => none,
  }

// claude -p --output-format json prints one object: the reply's text in result, or
// is_error with what went wrong. A reply with no JSON in it is words for the person.
fn parse(out: String) -> Result[Answer, String] = match json.parse(string.trim(out)) {
  err(e) => err("claude: unreadable output (" + e + "): " + string.take(string.trim(out), 300)),
  ok(r) => if json.get_bool(r, "is_error") ?? false then err("claude: " + string.take(str_of(r, "result") + " " + str_of(r, "subtype"), 300))
    else {
      let text = str_of(r, "result")
      let so = match object_in(text) {
        some(v) => if option.is_some(json.get_array(v, "tool_calls")) or option.is_some(json.get_string(v, "content")) then v
          else value.object([("content", value.str(text))]),
        none => value.object([("content", value.str(text))]),
      }
      {
        let usage = value.field(r, "usage") ?? value.object([])
        let calls = list.map(json.get_array(so, "tool_calls") ?? [], (c) =>
          (str_of(c, "name"), json.stringify(value.field(c, "arguments") ?? value.object([]))))
        ok(Answer { content: str_of(so, "content"), calls: calls, session: str_of(r, "session_id"),
          input_tokens: num(usage, "input_tokens") + num(usage, "cache_creation_input_tokens"),
          cached_tokens: num(usage, "cache_read_input_tokens"), output_tokens: num(usage, "output_tokens"),
          cost_usd: json.get_float(r, "total_cost_usd") ?? 0.0 })
      }
    },
}

test "a fresh session gets the conversation, a continued one only what is new" {
  let call = value.object([("id", value.str("c1")), ("type", value.str("function")),
    ("function", value.object([("name", value.str("read")), ("arguments", value.str("{\"path\":\"a.py\"}"))]))])
  let ms = [
    value.object([("role", value.str("system")), ("content", value.str("sys"))]),
    value.object([("role", value.str("user")), ("content", value.str("fix a.py"))]),
    value.object([("role", value.str("assistant")), ("content", value.str("")), ("tool_calls", value.array([call]))]),
    value.object([("role", value.str("tool")), ("tool_call_id", value.str("c1")), ("content", value.str("1 x = 1"))]),
  ]
  assert_eq(render(ms, 3, false), "Result of read:\n1 x = 1")
  let fresh = render(ms, 0, true)
  assert(string.starts_with(fresh, "User: fix a.py\n\nYou said: \nYou called: read {\"path\":\"a.py\"}"))
  assert(string.ends_with(fresh, "Result of read:\n1 x = 1"))
}

test "a session is continued only while it still matches" {
  let s = some(State { id: "abc", sent: 4, model: "claude" })
  assert_eq(continuing(s, 6, "claude"), s)
  assert_eq(continuing(s, 2, "claude"), none)
  assert_eq(continuing(s, 6, "claude:opus"), none)
  assert_eq(state_of(state_text(State { id: "abc", sent: 4, model: "claude" })), s)
}

test "the answer is the JSON in the reply's text, plain words are an answer, an error is an error" {
  let reply = "```json\n{\"content\":\"\",\"tool_calls\":[{\"name\":\"read\",\"arguments\":{\"path\":\"a.py\"}}]}\n```"
  let out = json.stringify(value.object([("type", value.str("result")), ("is_error", value.bool(false)), ("session_id", value.str("s1")),
    ("total_cost_usd", value.float(0.01)), ("result", value.str(reply)),
    ("usage", value.object([("input_tokens", value.int(2)), ("cache_creation_input_tokens", value.int(1000)), ("cache_read_input_tokens", value.int(500)), ("output_tokens", value.int(40))]))]))
  match parse(out) {
    ok(a) => {
      assert_eq(a.calls, [("read", "{\"path\":\"a.py\"}")])
      assert_eq(a.session, "s1")
      assert_eq(a.input_tokens, 1002)
      assert_eq(a.cached_tokens, 500)
    },
    err(e) => assert_eq(e, ""),
  }
  assert(result.is_err(parse("{\"is_error\":true,\"result\":\"Not logged in\"}")))
  match parse("{\"is_error\":false,\"result\":\"Done: all tests pass.\"}") {
    ok(a) => { assert_eq(a.content, "Done: all tests pass."); assert(list.is_empty(a.calls)) },
    err(e) => assert_eq(e, ""),
  }
}
